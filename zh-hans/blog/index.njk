---
layout: base.njk
title: 海外业务知识库 | Leap
description: Leap官方博客，涵盖海外扩张、海外销售、代理商开拓、营销、跨境电商及各国信息，助力您的国际业务取得成功。
---

<!-- ▼ 顶部横幅 -->
<section class="section py-3xl" style="background: var(--color-primary-gradient); color: var(--color-white);">
    <div class="container text-center">
        <span class="text-white font-bold mb-sm d-block" style="opacity: 0.9; letter-spacing: 0.05em;">Leap Knowledge Base</span>
        <h1 class="text-white mb-md">海外业务知识库</h1>
        <p class="text-white mb-xl" style="font-size: var(--font-size-lg); max-width: 800px; margin-left: auto; margin-right: auto;">
            从海外拓展准备，到销售、代理商开拓、营销，<br>
            以及各国详细信息。系统学习实践知识。
        </p>
    </div>
</section>

<!-- ▼ 分类卡片 -->
<section class="section bg-white" style="position: relative; margin-top: -60px; padding-top: var(--space-lg); padding-bottom: var(--space-3xl);">
    <div class="container">

        <div class="flex justify-end mb-md" style="position: relative; z-index: 10;">
            <a href="/{{ locale }}/blog/list/" class="view-all-link">
                查看全部文章 &rarr;
            </a>
        </div>

        <!-- 6个分类卡片 -->
        <div class="grid-3" style="gap: 20px;">

            <!-- 1. 海外扩张 -->
            <a href="/{{ locale }}/blog/expansion/" class="manual-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:32px; height:32px; color: var(--color-primary-start);"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" /></svg>
                </div>
                <h2 class="manual-title">{{ topic_translation['expansion'][locale] }}</h2>
                <p class="manual-desc">从决策与商业计划，到法务、税务及风险管理，海外拓展的完整路线图。</p>
                <span class="manual-link">查看文章 &rarr;</span>
            </a>

            <!-- 2. 海外销售 -->
            <a href="/{{ locale }}/blog/sales/" class="manual-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:32px; height:32px; color: var(--color-primary-start);"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" /></svg>
                </div>
                <h2 class="manual-title">{{ topic_translation['sales'][locale] }}</h2>
                <p class="manual-desc">在海外创造销售额的实战技巧——从产品本地化、商务谈判，到合同签署与贸易实务。</p>
                <span class="manual-link">查看文章 &rarr;</span>
            </a>

            <!-- 3. 海外代理商 -->
            <a href="/{{ locale }}/blog/partner/" class="manual-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:32px; height:32px; color: var(--color-primary-start);"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" /></svg>
                </div>
                <h2 class="manual-title">{{ topic_translation['partner'][locale] }}</h2>
                <p class="manual-desc">通过代理商扩大销售渠道的方法——伙伴搜寻、合同谈判及激励管理。</p>
                <span class="manual-link">查看文章 &rarr;</span>
            </a>

            <!-- 4. 海外营销 -->
            <a href="/{{ locale }}/blog/marketing/" class="manual-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:32px; height:32px; color: var(--color-primary-start);"><path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 1 1 0-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 0 1-1.44-4.282m3.102.069a18.03 18.03 0 0 1-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 0 1 8.835 2.535M10.34 6.66a23.847 23.847 0 0 1 8.835-2.535m0 0A23.74 23.74 0 0 0 18.795 3m.38 1.125a23.91 23.91 0 0 1 1.014 5.795 23.944 23.944 0 0 1-1.014 5.795m-3.8-11.58a23.917 23.917 0 0 0-4.636 2.02" /></svg>
                </div>
                <h2 class="manual-title">{{ topic_translation['marketing'][locale] }}</h2>
                <p class="manual-desc">打动当地客户的推广策略——市场调研、网络营销、展会及社交媒体运营。</p>
                <span class="manual-link">查看文章 &rarr;</span>
            </a>

            <!-- 5. 跨境电商 -->
            <a href="/{{ locale }}/blog/ec/" class="manual-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:32px; height:32px; color: var(--color-primary-start);"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" /></svg>
                </div>
                <h2 class="manual-title">{{ topic_translation['ec'][locale] }}</h2>
                <p class="manual-desc">跨境电商的开设与运营全攻略——平台选择、物流、支付及客户服务。</p>
                <span class="manual-link">查看文章 &rarr;</span>
            </a>

            <!-- 6. 国家与地区信息 -->
            <a href="/{{ locale }}/blog/countries/" class="manual-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:32px; height:32px; color: var(--color-primary-start);"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" /></svg>
                </div>
                <h2 class="manual-title">{{ topic_translation['countries'][locale] }}</h2>
                <p class="manual-desc">深度解析越南、新加坡、泰国、美国等各国市场环境、法律法规与商业惯例。</p>
                <span class="manual-link">查看文章 &rarr;</span>
            </a>

        </div>
    </div>
</section>

<!-- ▼ 最新文章 -->
<section id="latest-articles-section" class="section py-xl bg-beige">
    <div class="container">

        <div class="flex justify-between items-center mb-lg" style="width: 100%; justify-content: space-between; gap: 20px;">
            <h2 id="section-title" class="text-xl font-bold" style="border-left: 5px solid var(--color-primary-start); padding-left: 15px;">最新文章</h2>
        </div>

        <div class="grid-3" id="posts-container">
            {% set displayed_count = 0 %}

            {% for post in collections.blog | reverse %}
                {% if post.data.locale and post.data.locale == locale %}

                    {% set topic_label = topic_translation[post.data.topic][locale] %}
                    {% if not topic_label %}
                        {% set topic_label = post.data.topic %}
                    {% endif %}

                    <article class="card p-0 blog-item"
                             data-tags="{{ post.data.tags | join(',') }}"
                             style="padding: 0; overflow: hidden; display: {% if displayed_count < 6 %}flex{% else %}none{% endif %}; flex-direction: column; border: 1px solid var(--color-border); box-shadow: none; background: white; border-radius: 8px; transition: transform 0.2s;">

                        <a href="{{ post.url }}" style="display: block; aspect-ratio: 16/9; overflow: hidden;">
                            <img src="{{ post.data.thumbnail | default('https://placehold.co/600x400/f1f5f9/94a3b8?text=No+Image') }}"
                                 alt="{{ post.data.title }}"
                                 style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;">
                        </a>

                        <div class="px-lg py-lg flex-col" style="flex: 1; display: flex;">
                            <div class="flex justify-between items-center mb-sm">
                                <span class="text-primary font-bold" style="font-size: 12px; background: rgba(193, 0, 51, 0.1); padding: 4px 8px; border-radius: 4px;">
                                    {{ topic_label }}
                                </span>
                                <time style="font-size: 12px; color: var(--color-text-secondary);">
                                    {{ post.date | date("yyyy.MM.dd") }}
                                </time>
                            </div>

                            <h3 style="font-size: 1.1rem; margin-bottom: var(--space-sm); line-height: 1.4; font-weight: bold;">
                                <a href="{{ post.url }}" style="color: inherit; text-decoration: none;">
                                    {{ post.data.title }}
                                </a>
                            </h3>

                            <p class="text-secondary mb-lg" style="flex: 1; font-size: 0.9rem; line-height: 1.6; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;">
                                {{ post.data.description }}
                            </p>

                            <div class="flex items-center pt-sm" style="border-top: 1px solid #eee;">
                                <div style="width: 24px; height: 24px; border-radius: 50%; background: #ccc; margin-right: 8px; overflow: hidden;">
                                    <img src="{{ post.data.author_image | default('https://placehold.co/100x100/ddd/fff?text=User') }}" alt="author" style="width:100%; height:100%; object-fit:cover;">
                                </div>
                                <span style="font-size: 12px; font-weight: bold; color: var(--color-text-primary);">
                                    {{ post.data.author | default('Leap 编辑部') }}
                                </span>
                            </div>
                        </div>
                    </article>
                    {% set displayed_count = displayed_count + 1 %}
                {% endif %}
            {% endfor %}

            {% if displayed_count == 0 %}
                 <div class="text-center w-full py-3xl" style="grid-column: 1/-1;">
                    <p class="text-secondary">暂无文章。</p>
                </div>
            {% endif %}
        </div>

        <div id="no-result-msg" class="text-center w-full py-3xl text-secondary" style="display: none;">
            未找到相关文章。
        </div>

    </div>
</section>

{% include "cta1.njk" %}

<style>
    .view-all-link {
        color: var(--color-primary-start);
        font-weight: bold;
        text-decoration: none;
        font-size: 0.95rem;
        transition: transform 0.2s, opacity 0.2s;
        display: inline-block;
    }
    .view-all-link:hover { transform: translateX(5px); opacity: 0.8; text-decoration: underline; }

    .manual-card {
        display: block;
        background: white;
        padding: 30px 20px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        text-decoration: none;
        color: inherit;
        transition: transform 0.3s, box-shadow 0.3s;
        border: 1px solid rgba(0,0,0,0.05);
        text-align: center;
        height: 100%;
    }
    .manual-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.1); border-color: var(--color-primary-start); }

    .icon-box {
        background: #fff5f7;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .manual-title { font-size: 1.25rem; font-weight: bold; margin-bottom: 10px; color: var(--color-text-primary); }
    .manual-desc { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 20px; }
    .manual-link { font-size: 0.9rem; font-weight: bold; color: var(--color-primary-start); }

    .blog-item:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important; }
    .blog-item:hover h3 a { color: var(--color-primary-start) !important; }
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const urlParams = new URLSearchParams(window.location.search);
    const targetTag = urlParams.get('tag');

    if (targetTag) {
        const sectionTitle = document.getElementById('section-title');
        const articles = document.querySelectorAll('.blog-item');
        const noResultMsg = document.getElementById('no-result-msg');
        let matchCount = 0;

        if (sectionTitle) sectionTitle.textContent = `#${targetTag} 相关文章`;

        articles.forEach(article => {
            const articleTags = article.getAttribute('data-tags') || "";
            if (articleTags.includes(targetTag)) {
                article.style.display = 'flex';
                matchCount++;
            } else {
                article.style.display = 'none';
            }
        });

        if (matchCount === 0) noResultMsg.style.display = 'block';

        const section = document.getElementById('latest-articles-section');
        if (section) section.scrollIntoView({ behavior: 'smooth' });
    }
});
</script>
