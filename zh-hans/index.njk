/* ===== 導入事例 ===== */
.top-case-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
}
@media (max-width: 900px) { .top-case-grid { grid-template-columns: 1fr; max-width: 520px; margin-left: auto; margin-right: auto; } }
.top-case-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
