}

/* ===== Accordion ===== */
.accordion { margin-top: 1.25rem; }
.accordion-item {
    border-top: 1px solid #e5e7eb;
    padding: 1rem 0;
}
.accordion-item:last-child { border-bottom: 1px solid #e5e7eb; }
.accordion-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    color: #1a1a2e;
    list-style: none;
    user-select: none;
}
.accordion-trigger::-webkit-details-marker { display: none; }
details[open] .accordion-trigger .acc-icon { transform: rotate(45deg); }
.acc-icon {
    font-size: 1.3rem;
    color: #9ca3af;
    transition: transform 0.2s;
    flex-shrink: 0;
}
.accordion-body {
    padding-top: 0.5rem;
    font-size: 0.9rem;
    color: #666;
    line-height: 1.7;
}

/* ===== テンプレート ===== */
.top-tpl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
}
@media (max-width: 900px) { .top-tpl-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) {
