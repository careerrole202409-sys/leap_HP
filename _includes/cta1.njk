<!-- CTA Section Component -->
<style>
    /* ===================================
       CTA Section Styles (Self-contained)
       =================================== */
    .section-cta {
        background-color: #26000a; /* Deep dark red/black */
        color: #ffffff;
        position: relative;
        overflow: hidden;
    }

    .cta-image-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
    }

    .cta-blob-background {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 120%;
        height: 120%;
        background: linear-gradient(135deg, #C10033 0%, #8B0024 100%);
        border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
        z-index: 0;
        opacity: 0.8;
        max-width: 550px;
    }

    .cta-image {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 500px;
        margin: 0 auto;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        display: block;
    }

    .btn-cta-primary {
        background: linear-gradient(135deg, #C10033 0%, #8B0024 100%);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 4px 14px 0 rgba(193, 0, 51, 0.4);
    }
    
    .btn-cta-primary:hover {
        opacity: 0.9;
        transform: translateY(-2px);
        color: #ffffff;
    }

    .btn-cta-outline {
        background: transparent;
        color: #ffffff;
        border: 1px solid #ffffff;
    }

    .btn-cta-outline:hover {
        background-color: rgba(255, 255, 255, 0.1);
        color: #ffffff;
    }
</style>

<section class="section section-cta py-3xl">
    <div class="container">
        <div class="grid-2 items-center" style="gap: 3rem;">
            
            <!-- Left: Image & Decoration -->
            <div class="cta-image-wrapper">
                <div class="cta-blob-background"></div>
                <img src="https://res.cloudinary.com/duh6rnjba/image/upload/f_auto,q_auto,w_900/v1780199379/f2e65838-a2f4-4a3c-8bc4-0666632aad0b.png" alt="Leap website builder" class="cta-image">
            </div>

            <!-- Right: Text & Buttons -->
            <div class="text-left">
                <h2 id="cta-title" class="mb-lg text-white" style="font-size: 2.25rem;">
                    チャットだけで、グローバル水準のサイトを。
                </h2>

                <p id="cta-subtitle" class="mb-lg text-white font-bold" style="font-size: 1.125rem; line-height: 1.6;">
                    AIがサイトを作って、最適化して、グローバルに届ける
                </p>

                <p id="cta-desc" class="mb-xl text-white" style="line-height: 1.8; opacity: 0.9;">
                    ECサイト・ウェブサイト・LPの作成から多言語展開・AI自動最適化まで、すべてAIチャットだけで完結。あなたは話しかけるだけ。
                </p>

                <div class="flex flex-wrap" style="gap: 1rem;">
                    <a id="cta-demo-btn" href="/{{ locale }}/about/#contact" class="btn btn-lg btn-cta-primary">
                        デモを申し込む &rarr;
                    </a>
                    <a id="cta-free-btn" href="https://app.leap.site" target="_blank" rel="noopener" class="btn btn-lg btn-cta-outline">
                        無料で始める &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
(function() {
    // 翻訳データ定義
    const ctaTranslations = {
        ja: {
            title: 'チャットだけで、グローバル水準のサイトを。',
            subtitle: 'AIがサイトを作って、最適化して、グローバルに届ける',
            desc: 'ECサイト・ウェブサイト・LPの作成から多言語展開・AI自動最適化まで、すべてAIチャットだけで完結。あなたは話しかけるだけ。',
            demo: 'デモを申し込む &rarr;',
            free: '無料で始める &rarr;'
        },
        en: {
            title: 'Say it. Build it. Go global.',
            subtitle: 'The AI website builder that works entirely through chat.',
            desc: 'Build e-commerce stores, websites, and landing pages. Go multilingual. Let AI optimize for you — all through a single conversation. You talk, Leap builds.',
            demo: 'Book a Demo &rarr;',
            free: 'Get Started Free &rarr;'
        },
        'zh-hans': {
            title: '开口说，建好站，走向全球。',
            subtitle: '只需对话的 AI 建站工具，从创建到全球化一站搞定',
            desc: '电商网站、官网、落地页——创建、多语言拓展、AI 自动优化，全通过 AI 对话完成。你只需开口，Leap 搞定其余。',
            demo: '申请演示 &rarr;',
            free: '免费开始 &rarr;'
        }
    };

    // 現在の言語を取得 (header.jsと同じロジック)
    function getCtaLanguage() {
        const path = window.location.pathname;
        const match = path.match(/^\/(ja|jp|en|zh-hans)(\/|$)/);
        if (!match) return 'ja';
        return match[1] === 'jp' ? 'ja' : match[1];
    }

    // コンテンツ更新処理
    function updateCtaContent() {
        const lang = getCtaLanguage();
        const t = ctaTranslations[lang] || ctaTranslations['ja']; // フォールバック

        const titleEl = document.getElementById('cta-title');
        const subtitleEl = document.getElementById('cta-subtitle');
        const descEl = document.getElementById('cta-desc');
        const demoBtnEl = document.getElementById('cta-demo-btn');
        const freeBtnEl = document.getElementById('cta-free-btn');

        if (titleEl) titleEl.innerHTML = t.title;
        if (subtitleEl) subtitleEl.textContent = t.subtitle;
        if (descEl) descEl.innerHTML = t.desc;
        if (demoBtnEl) demoBtnEl.innerHTML = t.demo;
        if (freeBtnEl) freeBtnEl.innerHTML = t.free;
    }

    // 実行
    document.addEventListener('DOMContentLoaded', updateCtaContent);
})();
</script>