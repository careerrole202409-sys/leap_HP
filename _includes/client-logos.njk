<!-- Section: Client Logos -->
<section class="client-logos-section">
    <style>
        .client-logos-section {
            background: #fff;
            padding: 2rem 0;
            overflow: hidden;
        }
        .client-logos-title {
            text-align: center;
            font-size: 1.05rem;
            color: #1a1a2e;
            font-weight: 600;
            margin-bottom: 1.5rem;
            padding: 0 1rem;
        }
        .client-logos-marquee-wrapper {
            width: 100%;
            overflow: hidden;
            -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
            mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
        }
        .client-logos-track {
            display: flex;
            align-items: center;
            gap: 4rem;
            width: max-content;
            animation: logos-scroll 40s linear infinite;
        }
        .client-logos-track:hover { animation-play-state: paused; }
        .client-logo-img {
            height: 52px;
            width: auto;
            object-fit: contain;
            mix-blend-mode: multiply;
            opacity: 0.75;
            flex-shrink: 0;
            transition: opacity 0.2s;
        }
        .client-logo-img:hover { opacity: 1; }
        /* 余白のない横長ロゴは、ほかのロゴと見た目の大きさを揃えるため小さめに */
        .client-logo-img.is-wide { height: 30px; }
        @keyframes logos-scroll {
            0%   { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        @media (max-width: 768px) {
            .client-logo-img { height: 40px; }
            .client-logo-img.is-wide { height: 24px; }
            .client-logos-track { gap: 3rem; }
        }
    </style>

    <p class="client-logos-title">
        {% if locale == 'en' %}
            Trusted by businesses of all sizes, including companies listed on the TSE Prime Market.
        {% elif locale == 'zh-hans' %}
            包括东京证券交易所Prime市场上市企业在内，众多企业都在使用 Leap。
        {% elif locale == 'zh-hant' %}
            眾多企業正在使用 Leap 建立網站與電商。
        {% else %}
            東証プライム上場企業をはじめ、多くの企業にご利用いただいています。
        {% endif %}
    </p>

