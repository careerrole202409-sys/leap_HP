---
layout: base.njk
---

{% set t_home = 'ホーム' %}
{% set t_hp_guide = 'HP作成マニュアル' %}
{% set t_contents = '目次' %}
{% set t_share = 'この記事をシェアする' %}
{% set t_read_time = '読了時間: 約' %}
{% set t_minutes = '分' %}
{% set t_toast = 'リンクをコピーしました' %}
{% set t_default_author = 'Leap 編集部' %}
{% set t_default_bio = 'HPビジネスのエキスパートチーム' %}
{% set date_format = "yyyy年MM月dd日" %}
{% set t_related = '関連記事' %}

{% if locale == 'en' %}
    {% set t_home = 'Home' %}
    {% set t_hp_guide = 'HP Creation Manual' %}
    {% set t_contents = 'Table of Contents' %}
    {% set t_share = 'Share this post' %}
    {% set t_read_time = 'Read time: approx.' %}
    {% set t_minutes = ' min' %}
    {% set t_toast = 'Link copied' %}
    {% set t_default_author = 'Leap Editorial Team' %}
    {% set t_default_bio = 'HP Business Experts' %}
    {% set date_format = "MMM dd, yyyy" %}
    {% set t_related = 'Related Articles' %}
{% elif locale == 'zh-hans' %}
    {% set t_home = '首页' %}
    {% set t_hp_guide = 'HP制作手册' %}
    {% set t_contents = '目录' %}
    {% set t_share = '分享此文章' %}
    {% set t_read_time = '阅读时间：约' %}
    {% set t_minutes = '分钟' %}
    {% set t_toast = '链接已复制' %}
    {% set t_default_author = 'Leap 编辑团队' %}
    {% set t_default_bio = 'HP业务专家团队' %}
    {% set date_format = "yyyy年MM月dd日" %}
    {% set t_related = '相关文章' %}
{% endif %}

{% set topic_name = hp_topic_translation[topic][locale] %}
{% if not topic_name %}
    {% set topic_name = topic_label | default(topic) %}
{% endif %}

<style>
    /* --- 基本レイアウト --- */
    .blog-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 24px;
    }

    /* --- パンくずリスト --- */
    .breadcrumb-nav {
        font-size: 1rem;
        color: #64748b;
        margin-bottom: 2rem;
        line-height: 1.5;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }
    .breadcrumb-nav a {
        color: #64748b;
        text-decoration: none;
        transition: color 0.2s;
    }
    .breadcrumb-nav a:hover {
        color: #C10033;
        text-decoration: underline;
    }
    .breadcrumb-separator {
        font-size: 0.9rem;
        color: #cbd5e1;
    }
    .breadcrumb-current {
        color: #94a3b8;
        font-weight: 500;
    }

    /* --- ヘッダー要素 --- */
    .topic-badge {
        display: inline-block;
        background-color: #C10033;
        color: white;
        font-weight: bold;
        font-size: 0.875rem;
        padding: 6px 18px;
        border-radius: 50px;
        margin-bottom: 1.5rem;
        letter-spacing: 0.05em;
    }

    .post-title {
        font-size: 2.5rem;
        font-weight: 800;
        line-height: 1.4;
        color: #1e293b;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
    }

    /* タグデザイン */
    .tag-chip {
        display: inline-block;
        background-color: #f1f5f9;
        color: #475569;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        margin-right: 8px;
        margin-bottom: 8px;
        transition: background 0.2s;
    }
    .tag-chip:hover {
        background-color: #e2e8f0;
        color: #C10033;
    }

    /* メタ情報 */
    .meta-info {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 24px;
        color: #64748b;
        font-size: 0.95rem;
        margin-bottom: 2rem;
        font-family: monospace, serif;
    }
    .meta-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .meta-icon {
        width: 18px; height: 18px; fill: #94a3b8;
    }

    /* 区切り線 */
    .header-divider {
        border: 0;
        border-top: 1px solid #e2e8f0;
        margin-bottom: 2rem;
    }

    /* 著者情報エリア */
    .author-section {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 3rem;
    }
    .author-avatar {
        width: 56px; height: 56px; border-radius: 50%; object-fit: cover; background-color: #e2e8f0;
    }
    .author-text {
        display: flex; flex-direction: column;
    }
    .author-name {
        font-weight: bold; font-size: 1rem; color: #1e293b; margin-bottom: 2px;
    }
    .author-bio {
        font-size: 0.85rem; color: #64748b;
    }

    /* --- 記事本文スタイル --- */
    .blog-content {
        font-size: 1.125rem;
        line-height: 1.9;
        color: #334155;
    }
    {% if locale == 'en' %}
    .blog-content {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        line-height: 1.7;
    }
    {% endif %}

    .blog-content h2 {
        font-size: 1.8rem;
        margin-top: 4rem;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #e2e8f0;
        color: #1e293b;
        font-weight: bold;
        scroll-margin-top: 100px;
    }
    .blog-content h3 {
        font-size: 1.5rem;
        margin-top: 3rem;
        margin-bottom: 1rem;
        font-weight: bold;
        color: #1e293b;
        position: relative;
        padding-left: 1rem;
        scroll-margin-top: 100px;
    }
    .blog-content h3::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.3em;
        bottom: 0.3em;
        width: 4px;
        background: #C10033;
        border-radius: 2px;
    }
    .blog-content p { margin-bottom: 2rem; }

    .blog-content img {
        display: block;
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 3rem auto;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    .blog-content ul, .blog-content ol { margin-bottom: 2rem; padding-left: 1.5rem; }
    .blog-content li { margin-bottom: 0.5rem; }

    /* シェアボタン */
    .share-buttons-container {
        display: flex;
        justify-content: center;
        gap: 32px;
        margin-top: 1rem;
    }

    .share-btn {
        width: 50px; height: 50px;
        border-radius: 50%; display: flex; align-items: center; justify-content: center;
        color: white; border: none; cursor: pointer; transition: transform 0.2s, opacity 0.2s;
    }
    .share-btn:hover { transform: translateY(-3px); opacity: 0.9; }
    .bg-x { background-color: #000; }
    .bg-facebook { background-color: #1877F2; }
    .bg-linkedin { background-color: #0A66C2; }
    .bg-copy { background-color: #64748B; }

    /* トースト通知 */
    #copy-toast {
        visibility: hidden; min-width: 200px; background-color: #333; color: #fff; text-align: center;
        border-radius: 4px; padding: 10px; position: fixed; z-index: 50; left: 50%; bottom: 30px;
        transform: translateX(-50%); opacity: 0; transition: opacity 0.3s, bottom 0.3s;
    }
    #copy-toast.show { visibility: visible; opacity: 1; bottom: 50px; }

    @media (max-width: 768px) {
        .post-title { font-size: 1.75rem; }
        .meta-info { gap: 12px; font-size: 0.85rem; }
        .blog-container { padding: 0 20px; }
    }
</style>

<!-- ▼ ページ上部エリア -->
<div class="bg-white pb-md" style="padding-top: 100px;">
    <div class="blog-container">

        <!-- 1. パンくずリスト -->
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            <a href="/{{ locale }}/">{{ t_home }}</a>
            <span class="breadcrumb-separator">›</span>
            <a href="/{{ locale }}/hp-guide/">{{ t_hp_guide }}</a>
            <span class="breadcrumb-separator">›</span>
            <a href="/{{ locale }}/hp-guide/{{ topic }}/">{{ topic_name }}</a>
            <span class="breadcrumb-separator">›</span>
            <span class="breadcrumb-current">{{ title | truncate(30) }}...</span>
        </nav>

        <!-- 2. トピックバッジ -->
        <div class="mb-md">
            <span class="topic-badge">
                {{ topic_name }}
            </span>
        </div>

        <!-- 3. 記事タイトル -->
        <h1 class="post-title">
            {{ title }}
        </h1>

        <!-- 4. タグ一覧 -->
        {% if tags %}
        <div class="mb-lg">
            {% for tag in tags %}
                {% if tag != 'hp-guide' %}
                <a href="/{{ locale }}/hp-guide/list/?tag={{ tag }}" class="tag-chip">#{{ tag }}</a>
                {% endif %}
            {% endfor %}
        </div>
        {% endif %}

        <!-- 5. メタ情報 -->
        <div class="meta-info">
            <div class="meta-item">
                <svg class="meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM9 14H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2zm-8 4H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2z"/></svg>
                <time datetime="{{ page.date }}">{{ page.date | date(date_format) }}</time>
            </div>
            <div class="meta-item">
                <svg class="meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
                {% set minutes = content | length | int / 500 | round %}
                <span>{{ t_read_time }} {{ minutes if minutes > 1 else 1 }}{{ t_minutes }}</span>
            </div>
        </div>

        <!-- 6. 区切り線 -->
        <hr class="header-divider">

        <!-- 7. 著者情報セクション -->
        <div class="author-section">
            <img src="{{ author_image | default('https://placehold.co/100x100/e2e8f0/94a3b8?text=User') }}"
                 alt="{{ author }}"
                 class="author-avatar">

            <div class="author-text">
                <div class="author-name">{{ author | default(t_default_author) }}</div>
                <div class="author-bio">{{ author_bio | default(t_default_bio) }}</div>
            </div>
        </div>

        <!-- 8. アイキャッチ画像 -->
        <div style="width: 100%; aspect-ratio: 16/9; overflow: hidden; border-radius: 12px; margin-bottom: 20px;">
            <img src="{{ thumbnail | default('https://placehold.co/1200x675/f1f5f9/94a3b8?text=Featured+Image') }}"
                 alt="{{ title }}"
                 style="width: 100%; height: 100%; object-fit: cover;">
        </div>

    </div>
</div>

<!-- ▼ 本文セクション -->
<section class="section pt-lg pb-3xl bg-white">
    <div class="blog-container">

        <!-- ▼ 目次エリア -->
        <div id="toc-container" style="display: none; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:24px; margin-bottom:48px;">
            <div style="font-weight:bold; margin-bottom:12px; text-align:center; color:#475569; font-size:1.1rem;">{{ t_contents }}</div>
            <ul id="toc-list" style="list-style:none; padding:0; margin:0;">
                <!-- JavaScriptで自動生成 -->
            </ul>
        </div>

        <!-- 記事本文 -->
        <div class="blog-content">
            {{ content | safe }}
        </div>

        <!-- シェアボタン -->
        <div class="mt-3xl py-xl border-t border-b border-gray-100 text-center">
            <p class="font-bold mb-md text-lg">{{ t_share }}</p>
            <div class="share-buttons-container">
                <a href="https://twitter.com/intent/tweet?url={{ page.url | absoluteUrl(site.url) }}&text={{ title }}" target="_blank" class="share-btn bg-x"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg></a>
                <a href="https://www.facebook.com/sharer/sharer.php?u={{ page.url | absoluteUrl(site.url) }}" target="_blank" class="share-btn bg-facebook"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036c-2.148 0-2.797 1.66-2.797 3.54v1.237h3.354l-.58 3.666h-2.776v7.98H9.102z"></path></svg></a>
                <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ page.url | absoluteUrl(site.url) }}" target="_blank" class="share-btn bg-linkedin"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg></a>
                <button onclick="copyToClipboard()" class="share-btn bg-copy"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M14.851 11.923c-.179-.641-.521-1.246-1.025-1.749-1.562-1.562-4.095-1.563-5.657 0l-4.998 4.998c-1.562 1.563-1.563 4.094 0 5.656 1.562 1.563-4.096 1.561 5.656 0l1.339-1.341c.446-.446.446-1.171 0-1.618-.446-.446-1.171-.446-1.618 0l-1.339 1.342c-.668.668-1.755.667-2.422-.002-.668-.669-.668-1.754 0-2.423l4.998-4.999c.668-.668 1.754-.668-2.421.001-.334-.334-.548-.756-.633 1.201.127.658.745 1.077 1.403.951.657-.126 1.078-.745.952-1.403.001-.001-.194-.436-.343-.612zm-3.702-5.465c.446.446 1.171.446 1.618 0l1.339-1.342c.668-.668 1.755-.667 2.423.002.668.669.668 1.754 0 2.423l-4.998 4.999c-.668.668-1.754.668-2.421.001-.334-.334-.548-.756-.633-1.201-.127-.658-.745-1.077-1.403-.951-.657.126-1.078.745-.952 1.403 0 0 .194.436.343.612.179.641.521 1.246 1.025 1.749 1.562 1.562 4.095 1.563 5.657 0l4.998-4.998c1.562-1.563 1.563-4.094 0-5.656-1.562-1.563-4.096-1.561-5.656 0l-1.339 1.341c-.446.446-.446 1.171 0 1.618z"/></svg></button>
            </div>
        </div>
    </div>
</section>

<!-- ▼ 関連記事 -->
{% set preCount = 0 %}
{% for post in collections['hp-guide'] | reverse %}
    {% if post.url != page.url and preCount < 3 and post.data.locale == locale %}
        {% set isRelated = false %}
        {% if tags %}
            {% for t in tags %}
                {% if t != 'hp-guide' and t in post.data.tags %}{% set isRelated = true %}{% endif %}
            {% endfor %}
        {% endif %}
        {% if isRelated %}{% set preCount = preCount + 1 %}{% endif %}
    {% endif %}
{% endfor %}

{% if preCount > 0 %}
<section class="section py-3xl bg-beige">
    <div class="container">
        <h2 class="text-center mb-xl" style="font-size: 1.75rem;">{{ t_related }}</h2>
        <div class="grid-3">
            {% set count = 0 %}
            {% for post in collections['hp-guide'] | reverse %}
                {% if post.url != page.url and count < 3 and post.data.locale == locale %}
                    {% set isRelated = false %}
                    {% if tags %}
                        {% for t in tags %}
                            {% if t != 'hp-guide' and t in post.data.tags %}{% set isRelated = true %}{% endif %}
                        {% endfor %}
                    {% endif %}
                    {% if isRelated %}
                        <article class="card p-0 bg-white shadow-sm border border-gray-100 rounded-lg overflow-hidden flex flex-col h-full">
                            <a href="{{ post.url }}" class="block aspect-video overflow-hidden"><img src="{{ post.data.thumbnail | default('https://placehold.co/600x400/f1f5f9/94a3b8?text=Image') }}" alt="{{ post.data.title }}" class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"></a>
                            <div class="p-lg flex-1 flex flex-col">
                                <h3 class="text-lg font-bold mb-2 leading-tight"><a href="{{ post.url }}" class="text-dark hover:text-primary transition-colors" style="text-decoration:none;color:inherit;">{{ post.data.title }}</a></h3>
                                <time class="text-xs text-secondary mt-auto block">{{ post.date | date(date_format) }}</time>
                            </div>
                        </article>
                        {% set count = count + 1 %}
                    {% endif %}
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<div class="bg-white">{% include "cta1.njk" %}</div>

<div id="copy-toast">{{ t_toast }}</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. 目次の自動生成
    const content = document.querySelector('.blog-content');
    const tocContainer = document.getElementById('toc-container');
    const tocList = document.getElementById('toc-list');

    if (content && tocContainer && tocList) {
        const headers = content.querySelectorAll('h2');

        if (headers.length > 0) {
            tocContainer.style.display = 'block';

            headers.forEach((header, index) => {
                if (!header.id) {
                    header.id = 'section-' + index;
                }

                const li = document.createElement('li');
                li.style.borderBottom = '1px dashed #cbd5e1';
                li.style.paddingBottom = '8px';
                li.style.marginBottom = '8px';
                li.style.fontSize = '1rem';

                const a = document.createElement('a');
                a.href = '#' + header.id;
                a.textContent = header.textContent;
                a.style.textDecoration = 'none';
                a.style.color = '#334155';

                a.onmouseover = function() { this.style.color = '#C10033'; };
                a.onmouseout = function() { this.style.color = '#334155'; };

                li.appendChild(a);
                tocList.appendChild(li);
            });
        }
    }

    // 2. リンクコピー機能
    window.copyToClipboard = function() {
        navigator.clipboard.writeText(window.location.href).then(() => {
            const toast = document.getElementById("copy-toast");
            toast.classList.add("show");
            setTimeout(() => toast.classList.remove("show"), 3000);
        });
    };
});
</script>
