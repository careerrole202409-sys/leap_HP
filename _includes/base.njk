<!DOCTYPE html>
<html lang="{{ locale | default('ja') }}">
<head>

<link rel="icon" href="/assets/favicon.png">

<title>{{ title }}</title>
  <meta name="description" content="{{ description }}">

  <!-- Open Graph / Facebook / LinkedIn -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.leap.site{{ page.url }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="https://www.leap.site/assets/og-image.png">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:title" content="{{ title }}">
  <meta property="twitter:description" content="{{ description }}">
  <meta property="twitter:image" content="https://www.leap.site/assets/og-image.png">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E0BHMWHJNK"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-E0BHMWHJNK');
    </script>

    <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "uxpxgpg8ea");
</script>
    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description or 'Leap - 海外進出をサポート' }}">
    <title>{{ title or 'Leap - 海外進出をサポート' }}</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/assets/images/favicon.ico">
    
    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/base.css">
    <link rel="stylesheet" href="/assets/css/header.css">
    <link rel="stylesheet" href="/assets/css/footer.css">
    {% block styles %}{% endblock %}
    
    <!-- Fonts (Optional: Google Fonts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body>
    <!-- Header -->
    {% include "header.njk" %}
    
    <!-- Main Content -->
    <main id="main-content">
        {{ content | safe }}
    </main>
    
    <!-- Footer -->
    {% include "footer.njk" %}
    
    {% block scripts %}{% endblock %}

    <!-- ▼ 固定CTA -->
    {% if locale == 'en' %}
        {% set cta_subtitle = 'Website Generation<br>AI Agent' %}
        {% set cta_btn = 'Start for Free →' %}
        {% set cta_btn_mini = 'Start for Free' %}
    {% elif locale == 'zh-hans' %}
        {% set cta_subtitle = '网站生成<br>AI代理' %}
        {% set cta_btn = '免费开始 →' %}
        {% set cta_btn_mini = '免费开始' %}
    {% else %}
        {% set cta_subtitle = 'Webサイト生成<br>AIエージェント' %}
        {% set cta_btn = '無料ではじめる →' %}
        {% set cta_btn_mini = '無料ではじめる' %}
    {% endif %}
    <style>
        #fixed-cta-card {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 290px;
            background: white;
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.18);
            overflow: hidden;
            z-index: 9999;
            transition: opacity 0.28s, transform 0.28s;
        }
        #fixed-cta-tab {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: linear-gradient(135deg, #C10033 0%, #8B0024 100%);
            border-radius: 40px;
            box-shadow: 0 4px 18px rgba(193,0,51,0.35);
            z-index: 9999;
            display: none;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            transition: opacity 0.28s, transform 0.28s;
        }
        @media (max-width: 768px) {
            #fixed-cta-card { display: none !important; }
            #fixed-cta-tab { display: flex !important; }
            #fixed-cta-expand-btn { display: none !important; }
        }
    </style>

    <!-- 大カード -->
    <div id="fixed-cta-card">
        <!-- ✕ ボタン -->
        <button onclick="minimizeFixedCta()" style="position:absolute;top:9px;right:9px;width:24px;height:24px;border-radius:50%;border:none;background:rgba(255,255,255,0.25);color:white;font-size:13px;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:1;">✕</button>

        <!-- 赤グラデヘッダー -->
        <div style="background:linear-gradient(135deg,#C10033 0%,#8B0024 100%);padding:16px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <img src="https://res.cloudinary.com/duh6rnjba/image/upload/v1767489330/CareerRole%E6%A7%98_%E6%A8%AAwhite_RGB_4_vfmrzc.png"
                     alt="Leap" style="height:64px;display:block;flex-shrink:0;">
                <p style="color:white;font-size:13px;font-weight:bold;margin:0;line-height:1.4;">{{ cta_subtitle | safe }}</p>
            </div>
        </div>

        <!-- スクショ -->
        <div style="padding:12px 12px 0;">
            <a href="https://app.leap.site" target="_blank" rel="noopener noreferrer">
                <img src="https://res.cloudinary.com/duh6rnjba/image/upload/v1780199379/f2e65838-a2f4-4a3c-8bc4-0666632aad0b.png"
                     alt="Leap アプリ画面" style="width:100%;display:block;aspect-ratio:16/9;object-fit:cover;border-radius:8px;">
            </a>
        </div>

        <!-- CTAボタン -->
        <div style="padding:12px 14px 14px;">
            <a href="https://app.leap.site" target="_blank" rel="noopener noreferrer"
               style="display:block;background:linear-gradient(135deg,#C10033 0%,#8B0024 100%);color:white;text-align:center;padding:10px;border-radius:8px;font-size:13px;font-weight:bold;text-decoration:none;transition:opacity 0.2s;"
               onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
                {{ cta_btn }}
            </a>
        </div>
    </div>

    <!-- ミニタブ -->
    <div id="fixed-cta-tab">
        <!-- Leapロゴ -->
        <img src="https://res.cloudinary.com/duh6rnjba/image/upload/v1767489330/CareerRole%E6%A7%98_%E6%A8%AAwhite_RGB_4_vfmrzc.png"
             alt="Leap" style="height:60px;display:block;flex-shrink:0;margin:-15px 0;">
        <!-- 無料ではじめるリンク -->
        <a href="https://app.leap.site" target="_blank" rel="noopener noreferrer"
           style="color:#C10033;background:white;font-size:12px;font-weight:bold;text-decoration:none;white-space:nowrap;border-radius:20px;padding:6px 14px;transition:opacity 0.2s;"
           onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
            {{ cta_btn_mini }}
        </a>
        <!-- 展開ボタン -->
        <button id="fixed-cta-expand-btn" onclick="expandFixedCta()" style="background:rgba(255,255,255,0.2);border:none;color:white;width:26px;height:26px;border-radius:50%;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background 0.2s;"
                onmouseover="this.style.background='rgba(255,255,255,0.35)'" onmouseout="this.style.background='rgba(255,255,255,0.2)'">↑</button>
    </div>

    <script>
    function minimizeFixedCta() {
        var card = document.getElementById('fixed-cta-card');
        var tab  = document.getElementById('fixed-cta-tab');
        card.style.opacity = '0';
        card.style.transform = 'translateY(12px)';
        setTimeout(function() {
            card.style.display = 'none';
            tab.style.display = 'flex';
            requestAnimationFrame(function() {
                tab.style.opacity = '1';
                tab.style.transform = 'translateY(0)';
            });
        }, 280);
    }

    function expandFixedCta() {
        var card = document.getElementById('fixed-cta-card');
        var tab  = document.getElementById('fixed-cta-tab');
        tab.style.display = 'none';
        card.style.display = 'block';
        card.style.opacity = '0';
        card.style.transform = 'translateY(12px)';
        requestAnimationFrame(function() {
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
        });
    }
    </script>
</body>
</html>