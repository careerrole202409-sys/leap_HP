<!-- ヘッダー -->
<header class="header-container" id="header">
    <!-- 1行目：小さい行 -->
    <div class="header-top" id="headerTop">
        <div class="header-top-content">
            <div class="header-top-left">
                <div class="language-selector">
                    <div class="language-current" id="languageCurrent">
                        <span>🌐</span>
                        <span id="currentLang">日本語</span>
                        <span>▼</span>
                    </div>
                    <div class="language-dropdown" id="languageDropdown">
                        <a href="#" class="language-option" data-lang="ja" onclick="changeLanguage('ja'); return false;">日本語</a>
                        <a href="#" class="language-option" data-lang="en" onclick="changeLanguage('en'); return false;">English</a>
                        <a href="#" class="language-option" data-lang="zh-hans" onclick="changeLanguage('zh-hans'); return false;">简体中文</a>
                    </div>
                </div>
            </div>
            <div class="header-top-right">
                <a href="https://app.leap.site" class="header-top-link" id="loginLink">ログイン</a>
                <a href="https://www.leap.site/about" class="header-top-link" id="aboutLink">会社概要</a>
            </div>
        </div>
    </div>

    <!-- 2行目：メインナビゲーション -->
    <div class="header-main">
        <div class="header-main-content">
            <div class="nav-left">
                <a href="https://www.leap.site" class="logo">Leap</a>
                <nav class="nav-links">
                    <div class="nav-item">
                        <span class="nav-link" id="servicesLabel">サービス ▼</span>
                        <div class="dropdown-menu">
                            <a href="https://www.leap.site/services/multilingual-website" class="dropdown-item" id="serviceWebsite">多言語HP作成</a>
                            <a href="https://www.leap.site/services/cross-border-ec" class="dropdown-item" id="serviceEc">越境EC開設運用</a>
                            <a href="https://www.leap.site/services/multilingual-content" class="dropdown-item" id="serviceContent">多言語コンテンツ制作</a>
                            <a href="https://www.leap.site/services/global-sns" class="dropdown-item" id="serviceSns">海外向けSNS運用</a>
                        </div>
                    </div>
                    <a href="#" class="nav-link" id="pricingLink">価格</a>
                    <div class="nav-item">
                        <span class="nav-link" id="resourcesLabel">資料 ▼</span>
                        <div class="dropdown-menu">
                            <a href="https://www.leap.site/resources" target="_blank" rel="noopener noreferrer" class="dropdown-item" id="resourceDownload">資料ダウンロード</a>
                            <a href="https://blog.leap.site" target="_blank" rel="noopener noreferrer" class="dropdown-item" id="resourceBlog">ブログ</a>
                        </div>
                    </div>
                </nav>
            </div>
            <div class="nav-right">
                <a href="https://www.leap.site/contact" class="btn btn-demo" id="demoBtn">デモ</a>
                <a href="#" class="btn btn-start" id="startBtn">無料スタート</a>
            </div>

            <!-- ハンバーガーメニュー -->
            <div class="hamburger" id="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </div>
</header>

