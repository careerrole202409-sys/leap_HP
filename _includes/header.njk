<!-- ヘッダー -->
<header class="header-container" id="header">
    <!-- 1行目：小さい行 -->
    <div class="header-top" id="headerTop">
        <div class="header-top-content">
            <div class="header-top-left">
                <div class="language-selector">
                    <div class="language-current" id="languageCurrent">
                        <span>🌐</span>
                        <span id="currentLang">日本語</span>
                        <span>▼</span>
                    </div>
                    <div class="language-dropdown" id="languageDropdown">
                        <a href="#" class="language-option" data-lang="ja">日本語</a>
                        <a href="#" class="language-option" data-lang="en">English</a>
                        <a href="#" class="language-option" data-lang="zh-hans">简体中文</a>
                    </div>
                </div>
            </div>
            <div class="header-top-right">
                <a href="https://app.leap.site" class="header-top-link" id="loginLink">ログイン</a>
                <a href="/{{ locale }}/about" class="header-top-link" id="aboutLink">会社概要</a>
            </div>
        </div>
    </div>

    <!-- 2行目：メインナビゲーション -->
    <div class="header-main">
        <div class="header-main-content">
            <div class="nav-left">
                <!-- ロゴ画像を挿入 -->
                <a href="/{{ locale }}/" class="logo-link">
                    <img src="https://res.cloudinary.com/duh6rnjba/image/upload/v1767489330/CareerRole%E6%A7%98_%E6%A8%AAwhite_RGB_4_vfmrzc.png" alt="Leap" class="logo-img">
                </a>
                
                <nav class="nav-links">
                    <div class="nav-item">
                        <span class="nav-link" id="servicesLabel">サービス ▼</span>
                        <div class="dropdown-menu">
                            <a href="/{{ locale }}/services/multilingual-website" class="dropdown-item" id="serviceWebsite">多言語HP作成</a>
                            <a href="/{{ locale }}/services/multilingual-blog" class="dropdown-item" id="serviceBlog">多言語ブログ作成</a>
                            <a href="/{{ locale }}/services/ai-localize" class="dropdown-item" id="serviceAiLocalize">AI自動ローカライズ</a>
                        </div>
                    </div>
                    <a href="/{{ locale }}/pricing" class="nav-link" id="pricingLink">価格</a>
                    <div class="nav-item">
                        <span class="nav-link" id="resourcesLabel">資料 ▼</span>
                        <div class="dropdown-menu">
                            <a href="/{{ locale }}/resources" target="_blank" rel="noopener noreferrer" class="dropdown-item" id="resourceDownload">資料ダウンロード</a>
                            <a href="/{{ locale }}/blog" target="_blank" rel="noopener noreferrer" class="dropdown-item" id="resourceBlog">ブログ</a>
                        </div>
                    </div>
                </nav>
            </div>
            <div class="nav-right">
                <a href="/{{ locale }}/about/#contact" class="btn btn-demo" id="demoBtn">デモを申し込む</a>
                <a href="https://app.leap.site" target="_blank" rel="noopener noreferrer" class="btn btn-start" id="startBtn">無料スタート</a>
            </div>

            <!-- ハンバーガーメニュー -->
            <div class="hamburger" id="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </div>
</header>

<!-- モバイルメニュー -->
<div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu-content">
        <div class="mobile-nav-item">
            <a href="/{{ locale }}/" class="mobile-nav-link" id="mobileHome">ホーム</a>
        </div>
        
        <div class="mobile-nav-item">
            <div class="mobile-dropdown-toggle" onclick="toggleMobileDropdown(this)">
                <span id="mobileServicesText">サービス</span>
                <span>▼</span>
            </div>
            <div class="mobile-dropdown-content">
                <a href="/{{ locale }}/services/multilingual-website" class="mobile-dropdown-item" id="mobileServiceWebsite">多言語HP作成</a>
                <a href="/{{ locale }}/services/multilingual-blog" class="mobile-dropdown-item" id="mobileServiceBlog">多言語ブログ作成</a>
                <a href="/{{ locale }}/services/ai-localize" class="mobile-dropdown-item" id="mobileServiceAiLocalize">AI自動ローカライズ</a>
            </div>
        </div>

        <div class="mobile-nav-item">
            <a href="/{{ locale }}/pricing" class="mobile-nav-link" id="mobilePricing">価格</a>
        </div>

        <div class="mobile-nav-item">
            <div class="mobile-dropdown-toggle" onclick="toggleMobileDropdown(this)">
                <span id="mobileResourcesText">資料</span>
                <span>▼</span>
            </div>
            <div class="mobile-dropdown-content">
                <a href="/{{ locale }}/resources" target="_blank" rel="noopener noreferrer" class="mobile-dropdown-item" id="mobileResourceDownload">資料ダウンロード</a>
                <a href="/{{ locale }}/blog" target="_blank" rel="noopener noreferrer" class="mobile-dropdown-item" id="mobileResourceBlog">ブログ</a>
            </div>
        </div>

        <div class="mobile-nav-item">
            <a href="/{{ locale }}/about" class="mobile-nav-link" id="mobileAbout">会社概要</a>
        </div>

        <div class="mobile-cta-buttons">
            <a href="/{{ locale }}/about/#contact" class="btn btn-demo-mobile" id="mobileDemoBtn">デモを申し込む</a>
            <a href="https://app.leap.site" target="_blank" rel="noopener noreferrer" class="btn btn-start-mobile" id="mobileStartBtn">無料で始める</a>
        </div>
    </div>
</div>

<!-- ============================================
     多言語化ロジック (JavaScript)
============================================= -->
<script>
(function() {
    const translations = {
        ja: {
            langName: "日本語",
            login: "ログイン",
            about: "会社概要",
            servicesLabel: "サービス ▼",
            serviceWebsite: "多言語HP作成",
            serviceBlog: "多言語ブログ作成",
            serviceAiLocalize: "AI自動ローカライズ",
            pricing: "価格",
            resourcesLabel: "資料 ▼",
            resourceDownload: "資料ダウンロード",
            resourceBlog: "ブログ",
            demo: "デモを申し込む",
            start: "無料スタート",
            
            // モバイル専用
            mobileHome: "ホーム",
            mobileServicesText: "サービス",
            mobileResourcesText: "資料",
            mobileStart: "無料で始める"
        },
        en: {
            langName: "English",
            login: "Login",
            about: "About Us",
            servicesLabel: "Services ▼",
            serviceWebsite: "Multilingual Website",
            serviceBlog: "Multilingual Blog",
            serviceAiLocalize: "AI Localization",
            pricing: "Pricing",
            resourcesLabel: "Resources ▼",
            resourceDownload: "Downloads",
            resourceBlog: "Blog",
            demo: "Request Demo",
            start: "Start for Free",
            
            // モバイル専用
            mobileHome: "Home",
            mobileServicesText: "Services",
            mobileResourcesText: "Resources",
            mobileStart: "Start for Free"
        },
        'zh-hans': {
            langName: "简体中文",
            login: "登录",
            about: "公司简介",
            servicesLabel: "服务 ▼",
            serviceWebsite: "多语言建站",
            serviceBlog: "多语言博客",
            serviceAiLocalize: "AI本地化",
            pricing: "价格方案",
            resourcesLabel: "资料 ▼",
            resourceDownload: "资料下载",
            resourceBlog: "博客",
            demo: "申请演示",
            start: "免费开始",
            
            // モバイル専用
            mobileHome: "首页",
            mobileServicesText: "服务",
            mobileResourcesText: "资料",
            mobileStart: "免费开始"
        }
    };

    function getHeaderLanguage() {
        const path = window.location.pathname;
        const match = path.match(/^\/(ja|jp|en|zh-hans)(\/|$)/);
        if (!match) return 'ja';
        return match[1] === 'jp' ? 'ja' : match[1];
    }

    function updateHeaderContent() {
        const lang = getHeaderLanguage();
        const t = translations[lang] || translations['ja'];

        const setText = (id, text) => {
            const el = document.getElementById(id);
            if (el) el.textContent = text;
        };

        // 言語表示
        setText('currentLang', t.langName);

        // トップリンク
        setText('loginLink', t.login);
        setText('aboutLink', t.about);

        // メインナビゲーション (PC)
        setText('servicesLabel', t.servicesLabel);
        setText('serviceWebsite', t.serviceWebsite);
        setText('serviceBlog', t.serviceBlog);
        setText('serviceAiLocalize', t.serviceAiLocalize);
        setText('pricingLink', t.pricing);
        setText('resourcesLabel', t.resourcesLabel);
        setText('resourceDownload', t.resourceDownload);
        setText('resourceBlog', t.resourceBlog);
        setText('demoBtn', t.demo);
        setText('startBtn', t.start);

        // モバイルナビゲーション
        setText('mobileHome', t.mobileHome);
        setText('mobileServicesText', t.mobileServicesText);
        setText('mobileServiceWebsite', t.serviceWebsite);
        setText('mobileServiceBlog', t.serviceBlog);
        setText('mobileServiceAiLocalize', t.serviceAiLocalize);
        setText('mobilePricing', t.pricing);
        setText('mobileResourcesText', t.mobileResourcesText);
        setText('mobileResourceDownload', t.resourceDownload);
        setText('mobileResourceBlog', t.resourceBlog);
        setText('mobileAbout', t.about);
        setText('mobileDemoBtn', t.demo);
        setText('mobileStartBtn', t.mobileStart);
    }

    document.addEventListener('DOMContentLoaded', updateHeaderContent);
})();
</script>