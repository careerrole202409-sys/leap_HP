{% set t_home = 'ホーム' %}
{% set t_guide = 'HP作成ガイド' %}
{% set t_contents = '目次' %}
{% set t_share = 'この記事をシェアする' %}
{% set t_read_time = '読了時間: 約' %}
{% set t_minutes = '分' %}
{% set t_toast = 'リンクをコピーしました' %}
{% set date_format = "yyyy年MM月dd日" %}

{# ターゲット言語と親階層の設定 #}
{% set lang_name = target_lang | default("対象言語") %}
{% set lang_guide_name = lang_name + 'HP作成ガイド' %}
{% set lang_guide_url = parent_url | default('/' + (locale | default('ja')) + '/hp-guide/') %}

<style>
    /* --- 基本レイアウト --- */
    .blog-container { max-width: 1000px; margin: 0 auto; padding: 0 24px; }
    
    /* パンくずリスト */
    .breadcrumb-nav { font-size: 1rem; color: #64748b; margin-bottom: 2rem; line-height: 1.5; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .breadcrumb-nav a { color: #64748b; text-decoration: none; transition: color 0.2s; }
    .breadcrumb-nav a:hover { color: #C10033; text-decoration: underline; }
    .breadcrumb-separator { font-size: 0.9rem; color: #cbd5e1; }
    .breadcrumb-current { color: #94a3b8; font-weight: 500; }
    
    /* タイトルとヘッダーCTAのレイアウト (Flexbox) */
    .title-area {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 32px;
        margin-bottom: 1.5rem;
    }
    .post-title { 
        font-size: 2.5rem; 
        font-weight: 800; 
        line-height: 1.4; 
        color: #1e293b; 
        margin: 0; 
        letter-spacing: -0.02em; 
        flex: 1;
    }
    
    /* CTAカード（縦幅・高さあり） */
    .header-cta-group {
        flex-shrink: 0;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 40px 32px;    /* 縦幅を大きく */
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;             /* 要素間隔を広げる */
        min-width: 360px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }
    .header-cta-text {
        font-size: 1.15rem;
        font-weight: bold;
        color: #1e293b;
        margin: 0;
        line-height: 1.6;
    }
    .cta-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #C10033 0%, #8B0024 100%);
        color: white !important;
        font-weight: bold;
        padding: 16px 32px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 1.2rem;
        line-height: 1.4;
        width: 100%;
        box-shadow: 0 6px 12px -2px rgba(193, 0, 51, 0.3);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .cta-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 15px -3px rgba(193, 0, 51, 0.4);
    }

    /* メタ情報 */
    .meta-info { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; color: #64748b; font-size: 0.95rem; margin-bottom: 2rem; font-family: monospace, serif; }
    .meta-item { display: flex; align-items: center; gap: 8px; }
    .meta-icon { width: 18px; height: 18px; fill: #94a3b8; }
    
    /* ▼ 修正: 余白を1remに縮小 */
    .header-divider { border: 0; border-top: 1px solid #e2e8f0; margin-bottom: 0rem; }

    /* --- 記事本文スタイル --- */
    .blog-content { font-size: 1.125rem; line-height: 1.9; color: #334155; }
    .blog-content h2 { font-size: 1.8rem; margin-top: 4rem; margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 2px solid #e2e8f0; color: #1e293b; font-weight: bold; scroll-margin-top: 100px; }
    .blog-content h3 { font-size: 1.5rem; margin-top: 3rem; margin-bottom: 1rem; font-weight: bold; color: #1e293b; position: relative; padding-left: 1rem; scroll-margin-top: 100px; }
    .blog-content h3::before { content: ''; position: absolute; left: 0; top: 0.3em; bottom: 0.3em; width: 4px; background: #C10033; border-radius: 2px; }
    .blog-content p { margin-bottom: 2rem; }
    
    /* 記事下部の最終CTAボックス */
    .bottom-cta-box { margin: 4rem 0; padding: 3rem 2rem; background: #fffafb; border: 2px solid #C10033; border-radius: 12px; text-align: center; display: flex; flex-direction: column; align-items: center; }
    .bottom-cta-title { font-weight: bold; font-size: 1.5rem; margin-bottom: 1.5rem; color: #1e293b; }
    .bottom-cta-box .cta-btn-primary { width: auto; padding: 16px 48px; font-size: 1.2rem; border-radius: 8px; }

    /* トースト通知のスタイル */
    #copy-toast {
        visibility: hidden;
        min-width: 250px;
        background-color: #333;
        color: #fff;
        text-align: center;
        border-radius: 4px;
        padding: 16px;
        position: fixed;
        z-index: 50;
        left: 50%;
        bottom: 30px;
        transform: translateX(-50%);
        opacity: 0;
        transition: opacity 0.3s, bottom 0.3s;
    }
    #copy-toast.show {
        visibility: visible;
        opacity: 1;
        bottom: 50px;
    }

    @media (max-width: 768px) {
        .title-area { flex-direction: column; gap: 24px; }
        .post-title { font-size: 1.75rem; }
        .header-cta-group { width: 100%; min-width: auto; padding: 32px 20px; gap: 20px; }
        .meta-info { gap: 12px; font-size: 0.85rem; }
        .blog-container { padding: 0 20px; }
        .bottom-cta-box .cta-btn-primary { width: 100%; }
    }
</style>

<!-- ▼ ページ上部エリア -->
<div class="bg-white pb-0" style="padding-top: 100px;">
    <div class="blog-container">
        
        <!-- 1. パンくずリスト -->
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            <a href="/{{ locale | default('ja') }}/">{{ t_home }}</a>
            <span class="breadcrumb-separator">›</span>
            <a href="/{{ locale | default('ja') }}/hp-guide/">{{ t_guide }}</a>
            <span class="breadcrumb-separator">›</span>
            <a href="{{ lang_guide_url }}">{{ lang_guide_name }}</a>
            <span class="breadcrumb-separator">›</span>
            <span class="breadcrumb-current">{{ title }}</span>
        </nav>

        <!-- 2. タイトル & ヘッダーCTA (Flexbox配置) -->
        <div class="title-area">
            <h1 class="post-title">{{ title }}</h1>
            
            <div class="header-cta-group">
                <p class="header-cta-text">{{ lang_name }}専用にローカライズした<br>HPを無料作成</p>
                <a href="/{{ locale | default('ja') }}/register/" class="cta-btn-primary">
                    Leapで作成
                </a>
            </div>
        </div>

        <!-- 3. メタ情報 -->
        <div class="meta-info">
            <div class="meta-item">
                <svg class="meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM9 14H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2zm-8 4H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2z"/></svg>
                <time datetime="{{ page.date }}">{{ page.date | date(date_format) }}</time>
            </div>
            <div class="meta-item">
                <svg class="meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
                <span>{{ t_read_time }} 10{{ t_minutes }}</span>
            </div>
        </div>

        <hr class="header-divider">
    </div>
</div>

<!-- ▼ 本文セクション -->
<section class="section pt-0 pb-3xl bg-white">
    <div class="blog-container"> 
        
        <!-- 目次エリア -->
        <div id="toc-container" style="display: none; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:24px; margin-bottom:48px;">
            <div style="font-weight:bold; margin-bottom:12px; text-align:center; color:#475569; font-size:1.1rem;">{{ t_contents }}</div>
            <ul id="toc-list" style="list-style:none; padding:0; margin:0;"></ul>
        </div>

        <!-- 記事本文 -->
        <div class="blog-content">
            
            <h2>0. はじめに</h2>
            <h3>翻訳しただけのサイトが{{ lang_name }}圏で失敗する理由</h3>
            {% block section_0 %}{% endblock %}

            <h2>1. ネット環境と現地のルールを把握する</h2>
            <h3>1-1. 表記の選択：ターゲット地域に合わせた{{ lang_name }}の使い分け</h3>
            {% block section_1_1 %}{% endblock %}

            <h3>1-2. 表示速度とアクセスの壁：規制や外部ツールへの対応</h3>
            {% block section_1_2 %}{% endblock %}

            <h3>1-3. 法律とライセンス：公開前に確認すべき現地の決まり</h3>
            {% block section_1_3 %}{% endblock %}

            <h2>2. 現地で評価されるコンテンツとSEO対策</h2>
            <h3>2-1. ローカライズされたコンテンツ制作：信頼される情報と刺さる内容</h3>
            {% block section_2_1 %}{% endblock %}

            <h3>2-2. 検索エンジン（SEO）の最適化：現地主要ツールへの対応</h3>
            {% block section_2_2 %}{% endblock %}

            <h3>2-3. ドメインとサーバーの選び方：物理的な環境が検索順位に与える影響</h3>
            {% block section_2_3 %}{% endblock %}

            <h2>3. {{ lang_name }}サイトのデザイン・フォントの正解</h2>
            <h3>3-1. 色彩が与える印象と文化的な意味：その国での色の正解</h3>
            {% block section_3_1 %}{% endblock %}

            <h3>3-2. おすすめのフォントと文字サイズ：視認性を高める設定</h3>
            {% block section_3_2 %}{% endblock %}

            <h3>3-3. レイアウトと情報の密度：好まれるデザインの傾向</h3>
            {% block section_3_3 %}{% endblock %}

            <h2>4. お問い合わせとSNSの活用</h2>
            <h3>4-1. コンバージョンに繋がる窓口とSNS連携：適切な導線の作り方</h3>
            {% block section_4_1 %}{% endblock %}

            <h3>4-2. モバイルユーザーへの最適化：スマホ完結社会への対応</h3>
            {% block section_4_2 %}{% endblock %}

            <h2>5. まとめ</h2>
            <h3>{{ lang_name }}ホームページ制作で成功するためのチェックリスト</h3>
            {% block section_5 %}{% endblock %}

            <!-- 記事下部の最終CTA -->
            <div class="bottom-cta-box">
                <p class="bottom-cta-title">{{ lang_name }}専用にローカライズしたHPを無料作成</p>
                <a href="/{{ locale | default('ja') }}/register/" class="cta-btn-primary">
                    Leapで作成
                </a>
            </div>

            <!-- シェアボタン -->
            <div class="mt-3xl py-xl border-t border-b border-gray-100 text-center">
                <p class="font-bold mb-md text-lg">{{ t_share }}</p>
                <div class="share-buttons-container" style="display: flex; justify-content: center; gap: 32px; margin-top: 1rem;">
                    <a href="https://twitter.com/intent/tweet?url={{ page.url | absoluteUrl(site.url) }}&text={{ title }}" target="_blank" class="share-btn bg-x"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg></a>
                    <a href="https://www.facebook.com/sharer/sharer.php?u={{ page.url | absoluteUrl(site.url) }}" target="_blank" class="share-btn bg-facebook"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036c-2.148 0-2.797 1.66-2.797 3.54v1.237h3.354l-.58 3.666h-2.776v7.98H9.102z"></path></svg></a>
                    <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ page.url | absoluteUrl(site.url) }}" target="_blank" class="share-btn bg-linkedin"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg></a>
                    <button onclick="copyToClipboard()" class="share-btn bg-copy"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M14.851 11.923c-.179-.641-.521-1.246-1.025-1.749-1.562-1.562-4.095-1.563-5.657 0l-4.998 4.998c-1.562 1.563-1.563 4.094 0 5.656 1.562 1.563-4.096 1.561 5.656 0l1.339-1.341c.446-.446.446-1.171 0-1.618-.446-.446-1.171-.446-1.618 0l-1.339 1.342c-.668.668-1.755.667-2.422-.002-.668-.669-.668-1.754 0-2.423l4.998-4.999c.668-.668 1.754-.668-2.421.001-.334-.334-.548-.756-.633 1.201.127.658.745 1.077 1.403.951.657-.126 1.078-.745.952-1.403.001-.001-.194-.436-.343-.612zm-3.702-5.465c.446.446 1.171.446 1.618 0l1.339-1.342c.668-.668 1.755-.667 2.423.002.668.669.668 1.754 0 2.423l-4.998 4.999c-.668.668-1.754.668-2.421.001-.334-.334-.548-.756-.633-1.201-.127-.658-.745-1.077-1.403-.951-.657.126-1.078.745-.952 1.403 0 0 .194.436.343.612.179.641.521 1.246 1.025 1.749 1.562 1.562 4.095 1.563 5.657 0l4.998-4.998c1.562-1.563 1.563-4.094 0-5.656-1.562-1.563-4.096-1.561-5.656 0l-1.339 1.341c-.446.446-.446 1.171 0 1.618z"/></svg></button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- トースト通知 -->
<div id="copy-toast">{{ t_toast }}</div>

<!-- 目次・コピー機能スクリプト -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const content = document.querySelector('.blog-content');
    const tocContainer = document.getElementById('toc-container');
    const tocList = document.getElementById('toc-list');
    
    if (content && tocContainer && tocList) {
        const headers = content.querySelectorAll('h2');
        if (headers.length > 0) {
            tocContainer.style.display = 'block';
            headers.forEach((header, index) => {
                if (!header.id) header.id = 'section-' + index;
                const li = document.createElement('li');
                li.style.borderBottom = '1px dashed #cbd5e1';
                li.style.paddingBottom = '8px';
                li.style.marginBottom = '8px';
                li.style.fontSize = '1rem';
                const a = document.createElement('a');
                a.href = '#' + header.id;
                a.textContent = header.textContent;
                a.style.textDecoration = 'none';
                a.style.color = '#334155';
                a.onmouseover = function() { this.style.color = '#C10033'; };
                a.onmouseout = function() { this.style.color = '#334155'; };
                li.appendChild(a);
                tocList.appendChild(li);
            });
        }
    }

    window.copyToClipboard = function() {
        navigator.clipboard.writeText(window.location.href).then(() => {
            const toast = document.getElementById("copy-toast");
            toast.classList.add("show");
            setTimeout(() => toast.classList.remove("show"), 3000);
        });
    };
});
</script>