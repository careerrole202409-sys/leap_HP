<!-- _includes/language-guide.njk -->

<!-- HERO SECTION -->
<section class="section py-md" style="background: var(--color-primary-gradient); color: var(--color-white); overflow: hidden;">
    <div class="container">
        <div style="display: flex; align-items: stretch; gap: var(--space-2xl); flex-wrap: wrap;">

            <!-- 左：タイトル＋説明 -->
            <div style="flex: 2; min-width: 280px; display: flex; flex-direction: column; justify-content: center;">
                <a href="/{{ locale }}/hp-guide/" style="font-size: var(--font-size-sm); color: rgba(255,255,255,0.7); text-decoration: none; margin-bottom: var(--space-md); display: inline-block;">
                    ← HP作成ガイドに戻る
                </a>
                <h1 class="text-white mb-md">{{ title }}</h1>
                <p class="text-white mb-xl" style="font-size: var(--font-size-lg); opacity: 0.9;">
                    {{ description }}
                </p>
                <a href="#guides-section" class="btn btn-xl btn-white" style="align-self: flex-start;">
                    ガイドを見る ↓
                </a>
            </div>

            <!-- 右：Leapの使い方ボックス（PC） -->
            <div class="hero-right-box" style="flex: 1.5; min-width: 320px; background: var(--color-white); border-radius: 12px; padding: 60px; text-align: center; margin-top: -60px; margin-bottom: -60px; overflow: hidden;">
                <img 
                    src="https://res.cloudinary.com/duh6rnjba/image/upload/v1771677333/%E3%82%B9%E3%82%AF%E3%83%AA%E3%83%BC%E3%83%B3%E3%82%B7%E3%83%A7%E3%83%83%E3%83%88_2026-02-21_21.35.25_ose8qa.png"
                    alt="Leapの画面"
                    style="width: 100%; max-height: 200px; object-fit: cover; border-radius: 8px; margin-bottom: var(--space-md); box-shadow: 0 4px 20px rgba(0,0,0,0.1);"
                >
                <a href="/{{ locale }}/hp-guide/leap-howto/" class="btn btn-xl btn-primary" style="width: 100%; border: 2px solid var(--color-white);">
                    Leapの使い方を見る →
                </a>
            </div>

            <!-- SP時のみ：Leapの使い方ボタン -->
            <div class="hero-sp-btn">
                <a href="/{{ locale }}/hp-guide/leap-howto/" class="btn btn-xl btn-primary" style="width: 100%; border: 2px solid var(--color-white);">
                    Leapの使い方を見る →
                </a>
            </div>

        </div>
    </div>
</section>

<!-- GUIDES SECTION -->
<section id="guides-section" class="section py-xl bg-beige">
    <div class="container">
        <h2 class="text-center mb-lg" style="font-size: var(--font-size-3xl);">ガイド一覧</h2>

        <div class="grid-3">
            {% for post in collections.all %}
                {% if lang_code in post.url and post.data.locale == locale and post.url != "/" + locale + "/hp-guide/" + lang_code + "/" %}
                    <a href="{{ post.url }}"
                       class="card p-0"
                       style="overflow: hidden; display: flex; flex-direction: column; border: 1px solid var(--color-border); box-shadow: none; text-decoration: none; color: inherit;">

                        <div class="px-lg py-lg" style="flex: 1; display: flex; flex-direction: column;">
                            <h3 style="font-size: var(--font-size-lg); margin-bottom: var(--space-sm);">
                                {{ post.data.title }}
                            </h3>
                            <p class="text-secondary mb-lg" style="flex: 1; font-size: var(--font-size-sm);">
                                {{ post.data.description }}
                            </p>
                            <span class="text-primary font-bold">
                                詳しく見る &rarr;
                            </span>
                        </div>
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>

{% include "cta1.njk" %}

<style>
@media (max-width: 768px) {
    .hero-right-box {
        display: none !important;
    }
    .hero-sp-btn {
        display: block;
        width: 100%;
        margin-top: calc(-1 * var(--space-xl));
    }
    .hero-sp-btn .btn {
        text-align: center;
        justify-content: center;
    }
}
@media (min-width: 769px) {
    .hero-sp-btn {
        display: none;
    }
}
</style>