            payment_status_live: "已支持",
            payment_status_soon: "即将支持",
            payment_bank: "银行转账",
            payment_cycle: "结算周期：<strong>月末结算，次月末付款</strong>"
        }
    };

    function getPricingLanguage() {
        const path = window.location.pathname;
        const match = path.match(/^\/(ja|jp|en|zh-hans)(\/|$)/);
        if (!match) return 'ja';
        return match[1] === 'jp' ? 'ja' : match[1];
    }

    function updatePricingContent() {
        const lang = getPricingLanguage();
        const t = translations[lang] || translations['ja'];

        document.querySelectorAll('[data-i18n]').forEach(el => {
            const key = el.getAttribute('data-i18n');
            if (t[key] !== undefined) el.innerHTML = t[key];
        });
    }

    document.addEventListener('DOMContentLoaded', updatePricingContent);
})();
</script>
