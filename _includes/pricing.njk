<style>
    .pricing-wrapper {
        padding: 80px 0;
        overflow: hidden;
    }

    /* 比較表 */
    .pricing-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    .pricing-table {
        width: 100%;
        min-width: 680px;
        border-collapse: collapse;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }
    .pricing-table th,
    .pricing-table td {
        padding: 20px 16px;
        border-bottom: 1px solid var(--color-border);
        text-align: center;
        vertical-align: middle;
        font-size: 0.95rem;
    }
    .pricing-table thead th {
        background: var(--color-background-alt);
        color: var(--color-text-primary);
        font-size: 1.1rem;
        font-weight: bold;
        padding: 24px 16px;
    }
    .pricing-table tbody th {
        text-align: left;
        color: var(--color-text-secondary);
        font-weight: bold;
        white-space: nowrap;
        background: var(--color-background-alt);
    }
    .pricing-table tbody tr:last-child th,
    .pricing-table tbody tr:last-child td {
        border-bottom: none;
    }
    .pricing-table .price-cell {
        font-size: 1.3rem;
        font-weight: bold;
        color: var(--color-text-primary);
    }
    .pricing-table .cta-cell a {
        display: inline-block;
        width: 100%;
        padding: 12px 0;
        border-radius: 50px;
        background: linear-gradient(90deg, var(--color-primary-start, #C10033), var(--color-primary-end, #8B0024));
        color: #fff;
        font-weight: bold;
        text-decoration: none;
        font-size: 0.9rem;
        box-shadow: 0 4px 10px rgba(193, 0, 51, 0.2);
        transition: opacity 0.2s, transform 0.2s;
    }
    .pricing-table .cta-cell a:hover {
        opacity: 0.9;
        color: #fff;
        transform: translateY(-2px);
    }

    .pricing-notes {
        max-width: 900px;
        margin: 24px auto 0;
    }
    .pricing-notes p {
        font-size: 0.85rem;
        color: var(--color-text-secondary);
        line-height: 1.7;
    }

    /* 決済方法セクション */
    .payment-box {
        max-width: 900px;
        margin: 60px auto 0;
        background: #fff;
        border-radius: 20px;
        padding: 40px;
        border: 1px solid var(--color-border);
    }
    .payment-title {
        font-size: 1.3rem;
        font-weight: bold;
        color: var(--color-text-primary);
        margin-bottom: 24px;
        text-align: center;
    }
    .payment-methods {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
        margin-bottom: 20px;
    }
    .payment-method {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 50px;
        border: 1px solid var(--color-border);
        font-size: 0.9rem;
        font-weight: bold;
        color: var(--color-text-primary);
    }
    .payment-method.is-soon {
        color: var(--color-text-secondary);
    }
    .payment-status {
        font-size: 0.7rem;
        font-weight: bold;
        padding: 3px 10px;
        border-radius: 50px;
    }
    .payment-status.is-live {
        background: #e6f4ea;
        color: #1a7f37;
    }
    .payment-status.is-soon {
        background: var(--color-background-alt);
        color: var(--color-text-secondary);
    }
    .payment-cycle {
        text-align: center;
        font-size: 0.9rem;
        color: var(--color-text-secondary);
    }
    .payment-cycle strong {
        color: var(--color-text-primary);
    }

    /* スマホ向けカード表示（768px未満で表と入れ替え） */
    .pricing-cards-mobile {
        display: none;
    }
    .plan-card-mobile {
        background: #fff;
        border-radius: 16px;
        border: 1px solid var(--color-border);
        padding: 28px 20px;
        margin-bottom: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }
    .plan-card-mobile:last-child {
        margin-bottom: 0;
    }
    .plan-card-mobile .plan-card-name {
        font-size: 1.2rem;
        font-weight: bold;
        color: var(--color-text-primary);
        text-align: center;
        margin-bottom: 4px;
    }
    .plan-card-mobile .plan-card-price {
        font-size: 1.6rem;
        font-weight: bold;
        color: var(--color-text-primary);
        text-align: center;
        margin-bottom: 20px;
    }
    .plan-card-mobile .plan-card-price .price-unit {
        font-size: 0.8rem;
        font-weight: normal;
        color: var(--color-text-secondary);
    }
    .plan-card-mobile .spec-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 10px 0;
        border-top: 1px solid var(--color-border);
        font-size: 0.85rem;
    }
    .plan-card-mobile .spec-label {
        color: var(--color-text-secondary);
        flex-shrink: 0;
    }
    .plan-card-mobile .spec-value {
        color: var(--color-text-primary);
        text-align: right;
    }
    .plan-card-mobile .cta-cell a {
        display: block;
        margin-top: 20px;
        padding: 12px 0;
        border-radius: 50px;
        background: linear-gradient(90deg, var(--color-primary-start, #C10033), var(--color-primary-end, #8B0024));
        color: #fff;
        font-weight: bold;
        text-decoration: none;
        text-align: center;
        font-size: 0.95rem;
    }

    /* レスポンシブ */
    @media (max-width: 992px) {
        .payment-box { padding: 30px 20px; }
    }
    @media (max-width: 768px) {
        .pricing-table-wrap { display: none; }
        .pricing-cards-mobile { display: block; }
    }
</style>

