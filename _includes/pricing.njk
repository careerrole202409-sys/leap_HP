                <div id="pr-sub-std" class="plan-sub"></div>
                <div id="pr-price-std" class="plan-price"></div>
                <div id="pr-unit-std" class="plan-unit"></div>
                <ul id="pr-list-std" class="plan-features"></ul>
                <a href="/{{ locale }}/about/#contact" class="plan-btn" id="pr-btn-std"></a>
            </div>
            <div class="pricing-card" style="border: 2px solid var(--color-primary-start); box-shadow: 0 15px 40px rgba(0,0,0,0.1);">
                <div id="pr-badge-prem" class="refund-badge"></div>
                <div id="pr-name-prem" class="plan-name"></div>
                <div id="pr-sub-prem" class="plan-sub"></div>
                <div id="pr-price-prem" class="plan-price"></div>
                <div id="pr-unit-prem" class="plan-unit"></div>
                <ul id="pr-list-prem" class="plan-features"></ul>
                <a href="/{{ locale }}/about/#contact" class="plan-btn" id="pr-btn-prem"></a>
            </div>
            <div class="pricing-card" style="border: 2px solid var(--color-primary-start);">
                <div id="pr-badge-ent" class="refund-badge"></div>
                <div id="pr-name-ent" class="plan-name"></div>
                <div id="pr-sub-ent" class="plan-sub"></div>
                <div id="pr-price-ent" class="plan-price"></div>
                <div id="pr-unit-ent" class="plan-unit" style="visibility: hidden;">/月</div>
                <ul id="pr-list-ent" class="plan-features"></ul>
                <a href="/{{ locale }}/about/#contact" class="plan-btn" id="pr-btn-ent"></a>
            </div>
        </div>

        <div class="refund-detail-box">
            <h3 class="text-center mb-xl" style="font-size: 2rem; font-weight: bold;">
                <span id="pr-refund-title" style="border-bottom: 4px solid var(--color-primary-start);"></span>
            </h3>
            <div class="refund-step-grid">
                <div class="refund-condition-list">
                    <div id="pr-refund-cond1" class="condition-item"></div>
                    <div id="pr-refund-cond2" class="condition-item"></div>
                    <div id="pr-refund-cond3" class="condition-item"></div>
                </div>
                <div class="refund-arrow" style="font-size: 2rem; color: var(--color-primary-start);">▶</div>
                <div class="refund-result-card">
                    <div id="pr-refund-amount" class="refund-amount"></div>
                    <p id="pr-refund-commit" class="font-bold text-lg mb-md"></p>
                    <p id="pr-refund-reason" class="text-secondary text-sm"></p>
                </div>
            </div>
            <p id="pr-refund-footer" class="text-center mt-xl font-bold" style="font-size: 1.1rem;"></p>
        </div>
    </div>
</section>

