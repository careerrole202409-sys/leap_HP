    // 言語取得
    function getPricingLanguage() {
        const path = window.location.pathname;
        const match = path.match(/^\/(ja|jp|en|zh-hans)(\/|$)/);
        if (!match) return 'ja';
        return match[1] === 'jp' ? 'ja' : match[1];
    }

    // コンテンツ更新
    function updatePricingContent() {
        const lang = getPricingLanguage();
        const t = translations[lang] || translations['ja'];

        // Helper to safe set innerHTML
        const setHTML = (id, html) => {
            const el = document.getElementById(id);
            if (el) el.innerHTML = html;
        };

        // Header
        setHTML('pr-header-title', t.header_title);
        setHTML('pr-header-desc', t.header_desc);

        // Labels (Common)
        ['hp', 'content', 'sns', 'other'].forEach(cat => {
            setHTML(`pr-label-${cat}-free`, t[`label_${cat}`]);
            setHTML(`pr-label-${cat}-basic`, t[`label_${cat}`]);
            setHTML(`pr-label-${cat}-std`, t[`label_${cat}`]);
        });

        // Units
        setHTML('pr-unit-free', t.unit_month);
        setHTML('pr-unit-basic', t.unit_month);
        setHTML('pr-unit-std', t.unit_month);
        setHTML('pr-unit-addon', t.unit_month);

        // Free Plan
        setHTML('pr-free-sub', t.free_sub);
        setHTML('pr-free-btn', t.free_btn);
        setHTML('pr-list-hp-free', t.free_list_hp);
        setHTML('pr-list-content-free', t.free_list_content);
        setHTML('pr-list-sns-free', t.free_list_sns);
        setHTML('pr-list-other-free', t.free_list_other);

        // Basic Plan
        setHTML('pr-badge-basic', t.badge_basic);
        setHTML('pr-basic-sub', t.basic_sub);
        setHTML('pr-basic-btn', t.basic_btn);
        setHTML('pr-list-hp-basic', t.basic_list_hp);
        setHTML('pr-list-content-basic', t.basic_list_content);
        setHTML('pr-list-sns-basic', t.basic_list_sns);
        setHTML('pr-list-other-basic', t.basic_list_other);

        // Standard Plan
        setHTML('pr-badge-std', t.badge_std);
        setHTML('pr-std-sub', t.std_sub);
        setHTML('pr-std-btn', t.std_btn);
        setHTML('pr-list-hp-std', t.std_list_hp);
        setHTML('pr-list-content-std', t.std_list_content);
        setHTML('pr-list-sns-std', t.std_list_sns);
        setHTML('pr-list-other-std', t.std_list_other);

        // Add-ons
        setHTML('pr-addon-title', t.addon_title);
        setHTML('pr-addon-desc', t.addon_desc);
        setHTML('pr-addon-label', t.addon_label);
        setHTML('pr-addon-sub', t.addon_sub);
        setHTML('pr-addon-note', t.addon_note);
        
        setHTML('pr-opt-1-title', t.opt1_title);
        setHTML('pr-opt-1-list', t.opt1_list);
        setHTML('pr-opt-2-title', t.opt2_title);
        setHTML('pr-opt-2-list', t.opt2_list);
        setHTML('pr-opt-3-title', t.opt3_title);
        setHTML('pr-opt-3-list', t.opt3_list);

        setHTML('pr-footer-note', t.footer_note);
    }

    document.addEventListener('DOMContentLoaded', updatePricingContent);
})();
