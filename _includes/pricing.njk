    function getPricingLanguage() {
        const path = window.location.pathname;
        const match = path.match(/^\/(ja|jp|en|zh-hans)(\/|$)/);
        if (!match) return 'ja';
        return match[1] === 'jp' ? 'ja' : match[1];
    }

    function updatePricingContent() {
        const lang = getPricingLanguage();
        const t = translations[lang] || translations['ja'];

        const setHTML = (id, html) => {
            const el = document.getElementById(id);
            if (el) el.innerHTML = html;
        };

        // Header
        setHTML('pr-title', t.title);
        setHTML('pr-desc', t.desc);
        setHTML('pr-badge-std', t.badge_refund);
        setHTML('pr-badge-prem', t.badge_refund);

        // Plans
        ['free', 'starter', 'basic', 'std', 'prem'].forEach(plan => {
            setHTML(`pr-name-${plan}`, t[`${plan}_name`]);
            setHTML(`pr-sub-${plan}`, t[`${plan}_sub`]);
            setHTML(`pr-price-${plan}`, t[`${plan}_price`]);
            setHTML(`pr-unit-${plan}`, t.unit);
            setHTML(`pr-list-${plan}`, t[`${plan}_list`]);
        });
        
        // Buttons
        setHTML('pr-btn-free', t.btn_try_free);
        setHTML('pr-btn-starter', t.btn_try_free);
        setHTML('pr-btn-basic', t.btn_try_free);
        setHTML('pr-btn-std', t.btn_contact);
        setHTML('pr-btn-prem', t.btn_contact);

        // Refund Section
        setHTML('pr-refund-title', t.refund_title);
        setHTML('pr-refund-cond1', t.refund_cond1);
        setHTML('pr-refund-cond2', t.refund_cond2);
        setHTML('pr-refund-cond3', t.refund_cond3);
        setHTML('pr-refund-amount', t.refund_amount);
        setHTML('pr-refund-commit', t.refund_commit);
        setHTML('pr-refund-reason', t.refund_reason);
        setHTML('pr-refund-footer', t.refund_footer);
    }

    document.addEventListener('DOMContentLoaded', updatePricingContent);
})();
</script>