            prem_name: "プレミアム", prem_sub: "動的サイト＆多ページ対応", prem_price: "298,000円",
            prem_list: "<li class='font-bold'>スタンダードプランの機能</li><li>500ページまで</li><li>ECなど動的ウェブサイトの作成</li><li class='font-bold'>Leapの担当者が運用</li>",

            ent_name: "エンタープライズ", ent_sub: "ページ数無制限", ent_price: "別途お見積もり",
            ent_list: "<li class='font-bold'>プレミアムプランの機能</li><li>ページ数無制限</li><li class='font-bold'>Leapの担当者が運用</li>",

            refund_title: "返金保証とは？",
            refund_cond1: "開始時点で、お客様と海外からのアクセス数の目標値を定めます。",
            refund_cond2: "例えば、半年後、月間1,000件のアクセス数を目標に設定。",
            refund_cond3: "もし、実際の結果が月間800件のアクセスとなった場合...",
            refund_amount: "20%返金", refund_commit: "成果にコミットします",
            refund_reason: "Leapが価値を提供できなかった分、<br>しっかりと返金をさせていただきます。",
            refund_footer: "海外からのアクセス数を確実に伸ばし、認知拡大・売上向上につなげます。"
        },
        en: {
            title: "Pricing Plans",
            desc: "Choose the best plan tailored to your business scale.",
            tab_personal: "Personal", tab_business: "Business",
            badge_refund: "Money-back Guarantee!",
            unit: "/mo", btn_try_free: "Try for Free", btn_contact: "Contact Us",
            
            free_name: "Free", free_sub: "Try for free", free_price: "¥0",
            free_list: "<li>Up to 3 pages</li><li>No custom domain</li>",
            
            starter_name: "Starter", starter_sub: "Publish multilingual site", starter_price: "¥2,980",
            starter_list: "<li>Up to 10 pages</li><li>Custom domain supported</li>",
            
            basic_name: "Basic", basic_sub: "Publish multilingual blog", basic_price: "¥9,800",
            basic_list: "<li>Up to 50 pages</li><li>Multilingual blog setup</li>",
            
            std_name: "Standard", std_sub: "Managed by our experts", std_price: "¥98,000",
            std_list: "<li>Up to 150 pages</li><li>AI blog creation & SEO optimization</li><li>Website localization</li><li>Landing page optimization via A/B testing</li><li class='font-bold'>Dedicated support from a Leap expert</li>",
            
            prem_name: "Premium", prem_sub: "Dynamic site & High volume", prem_price: "¥298,000",
            prem_list: "<li class='font-bold'>Everything in Standard</li><li>Up to 500 pages</li><li>Dynamic site creation (e.g., e-commerce)</li><li class='font-bold'>Fully managed by a Leap expert</li>",

            ent_name: "Enterprise", ent_sub: "Unlimited pages", ent_price: "Custom Quote",
            ent_list: "<li class='font-bold'>Everything in Premium</li><li>Unlimited pages</li><li class='font-bold'>Fully managed by a Leap expert</li>",

            refund_title: "What is the Money-back Guarantee?",
            refund_cond1: "At the start, we set a target for overseas traffic together with you.",
            refund_cond2: "For example, targeting 1,000 monthly visits after 6 months.",
            refund_cond3: "If the actual result turns out to be only 800 monthly visits...",
            refund_amount: "20% Refund", refund_commit: "Committed to results",
            refund_reason: "We will refund the exact proportion of the value we failed to deliver.",
            refund_footer: "We ensure steady growth in overseas traffic, boosting your global sales."
        },
        'zh-hans': {
            title: "价格方案",
            desc: "根据您的业务规模选择最合适的方案。",
            tab_personal: "个人版", tab_business: "企业版",
            badge_refund: "退款保证！",
            unit: "/月", btn_try_free: "免费试用", btn_contact: "联系我们",
            
            free_name: "免费版", free_sub: "免费试用", free_price: "0日元",
            free_list: "<li>最多3个页面</li><li>不可使用独立域名</li>",
            
            starter_name: "入门版", starter_sub: "发布多语言网站", starter_price: "2,980日元",
            starter_list: "<li>最多10个页面</li><li>支持独立域名</li>",
            
            basic_name: "基础版", basic_sub: "发布多语言博客", basic_price: "9,800日元",
            basic_list: "<li>最多50个页面</li><li>搭建多语言博客</li>",
            
            std_name: "标准版", std_sub: "专属顾问全程跟进", std_price: "98,000日元",
            std_list: "<li>最多150个页面</li><li>AI自动生成博客及SEO优化</li><li>网站本地化</li><li>基于A/B测试优化落地页</li><li class='font-bold'>Leap专属顾问提供支持</li>",
            
            prem_name: "尊享版", prem_sub: "动态网站与多页面支持", prem_price: "298,000日元",
            prem_list: "<li class='font-bold'>包含标准版全部功能</li><li>最多500个页面</li><li>支持电商等动态网站制作</li><li class='font-bold'>Leap专属顾问全程运营</li>",

            ent_name: "企业版", ent_sub: "页面数量无限制", ent_price: "另行估价",
            ent_list: "<li class='font-bold'>包含尊享版全部功能</li><li>页面数量无限制</li><li class='font-bold'>Leap专属顾问全程运营</li>",

            refund_title: "什么是退款保证？",
            refund_cond1: "项目开始时，我们将与您共同设定海外访问量的目标值。",
            refund_cond2: "例如，设定6个月后每月海外访问量达到1,000次的目标。",
            refund_cond3: "如果实际结果只有每月800次访问...",
            refund_amount: "退款20%", refund_commit: "对效果全面负责",
            refund_reason: "由于未能达到预期效果，Leap将为您办理退款。",
            refund_footer: "我们将切实提升您的海外访问量，助您提升全球销售额。"
        }
    };

    window.switchTab = function(type) {
        document.querySelectorAll('.pricing-group').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
        
        if(type === 'personal') {
            document.getElementById('personal-plans').classList.add('active');
            document.getElementById('tab-label-personal').classList.add('active');
        } else {
            document.getElementById('business-plans').classList.add('active');
            document.getElementById('tab-label-business').classList.add('active');
        }
    };

    function getPricingLanguage() {
        const path = window.location.pathname;
        const match = path.match(/^\/(ja|jp|en|zh-hans)(\/|$)/);
        if (!match) return 'ja';
        return match[1] === 'jp' ? 'ja' : match[1];
    }

    function updatePricingContent() {
        const lang = getPricingLanguage();
        const t = translations[lang] || translations['ja'];

        const setHTML = (id, html) => {
            const el = document.getElementById(id);
            if (el) el.innerHTML = html;
        };

        setHTML('pr-title', t.title);
        setHTML('pr-desc', t.desc);
        setHTML('tab-label-personal', t.tab_personal);
        setHTML('tab-label-business', t.tab_business);
        setHTML('pr-badge-prem', t.badge_refund);
        setHTML('pr-badge-ent', t.badge_refund);

        ['free', 'starter', 'basic', 'std', 'prem', 'ent'].forEach(plan => {
            setHTML(`pr-name-${plan}`, t[`${plan}_name`]);
            setHTML(`pr-sub-${plan}`, t[`${plan}_sub`]);
            setHTML(`pr-price-${plan}`, t[`${plan}_price`]);
            setHTML(`pr-unit-${plan}`, t.unit);
            setHTML(`pr-list-${plan}`, t[`${plan}_list`]);
        });

        ['free', 'starter', 'basic'].forEach(id => setHTML(`pr-btn-${id}`, t.btn_try_free));
        ['std', 'prem', 'ent'].forEach(id => setHTML(`pr-btn-${id}`, t.btn_contact));

        setHTML('pr-refund-title', t.refund_title);
        setHTML('pr-refund-cond1', t.refund_cond1);
        setHTML('pr-refund-cond2', t.refund_cond2);
        setHTML('pr-refund-cond3', t.refund_cond3);
        setHTML('pr-refund-amount', t.refund_amount);
        setHTML('pr-refund-commit', t.refund_commit);
        setHTML('pr-refund-reason', t.refund_reason);
        setHTML('pr-refund-footer', t.refund_footer);
    }

    document.addEventListener('DOMContentLoaded', updatePricingContent);
})();
</script>