<style>
    :root {
        --color-tab-bg: #f0f0f0;
        --color-tab-active: var(--color-primary-start, #C8102E);
    }

    .pricing-wrapper {
        padding: 80px 0;
        overflow: hidden;
    }

    /* タブ切り替えボタン */
    .pricing-tabs {
        display: flex;
        justify-content: center;
        margin-bottom: 50px;
        gap: 10px;
    }
    .tab-btn {
        padding: 12px 30px;
        border-radius: 50px;
        border: 2px solid var(--color-tab-bg);
        background: var(--color-tab-bg);
        color: var(--color-text-secondary);
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 1rem;
    }
    .tab-btn.active {
        background: var(--color-tab-active);
        border-color: var(--color-tab-active);
        color: #fff;
        box-shadow: 0 4px 15px rgba(200, 16, 46, 0.3);
    }

    /* プラン表示制御 */
    .pricing-group {
        display: none; /* 初期は非表示 */
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        align-items: stretch;
    }
    .pricing-group.active {
        display: grid; /* アクティブなタブのみ表示 */
    }

    .pricing-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid var(--color-border);
        padding: 40px 20px;
        display: flex;
        flex-direction: column;
        text-align: center;
        position: relative;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        transition: transform 0.3s ease;
    }
    .pricing-card:hover {
        transform: translateY(-5px);
    }

    /* 返金保証バッジ */
    .refund-badge {
        position: absolute;
        top: -20px;
        left: 50%;
        transform: translateX(-50%);
        background: #FFF1AA;
        color: #000;
        font-weight: bold;
        padding: 8px 20px;
        border-radius: 50px;
        font-size: 0.85rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        z-index: 5;
        white-space: nowrap;
    }

    .plan-name {
        color: var(--color-primary-start);
        font-size: 1.5rem;
        font-weight: bold;
        margin-bottom: 5px;
    }
    .plan-sub {
        font-size: 0.85rem;
        color: var(--color-text-secondary);
        margin-bottom: 20px;
        height: 2.5em;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .plan-price {
        font-size: 2.2rem;
        font-weight: bold;
        color: var(--color-text-primary);
        line-height: 1;
    }
    .plan-unit {
        font-size: 1rem;
        color: var(--color-text-secondary);
        margin-bottom: 30px;
    }

    .plan-features {
        list-style: none;
        padding: 0;
        margin: 0 0 30px 0;
        text-align: left;
        font-size: 0.85rem;
        flex-grow: 1;
    }
    .plan-features li {
        margin-bottom: 12px;
        display: flex;
        align-items: flex-start;
        line-height: 1.4;
    }
    .plan-features li::before {
        content: "✔";
        color: var(--color-primary-start);
        margin-right: 8px;
        font-weight: bold;
        flex-shrink: 0;
    }

    .plan-btn {
        display: block;
        width: 100%;
        margin-top: auto;
        padding: 14px 0;
        border-radius: 50px;
        background: linear-gradient(90deg, var(--color-primary-start, #C8102E), var(--color-primary-end, #8A0C20));
        color: #ffffff;
        font-weight: bold;
        text-decoration: none;
        font-size: 1rem;
        box-shadow: 0 4px 10px rgba(200, 16, 46, 0.2);
        transition: opacity 0.2s, transform 0.2s;
    }
    .plan-btn:hover {
        opacity: 0.9;
        color: #ffffff;
        transform: translateY(-2px);
    }

    /* 返金保証詳細セクション */
    .refund-detail-box {
        margin-top: 80px;
        background: #fff;
        border-radius: 20px;
        padding: 60px;
        border: 1px solid var(--color-border);
    }
    .refund-step-grid {
        display: grid;
        grid-template-columns: 1fr 40px 1fr;
        align-items: center;
        gap: 30px;
    }
    .refund-condition-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    .condition-item {
        background: var(--color-beige, #f9f7f2);
        padding: 20px;
        border-left: 6px solid var(--color-primary-start);
        font-size: 0.95rem;
        font-weight: bold;
    }
    .refund-result-card {
        text-align: center;
        padding: 40px;
        border: 2px solid var(--color-primary-start);
        border-radius: 15px;
    }
    .refund-amount {
        font-size: 4rem;
        font-weight: 900;
        color: var(--color-primary-start);
        line-height: 1;
        margin-bottom: 15px;
    }

    /* レスポンシブ */
    @media (max-width: 992px) {
        .pricing-group.active { grid-template-columns: 1fr; max-width: 500px; margin: 0 auto; }
        .refund-step-grid { grid-template-columns: 1fr; }
        .refund-arrow { transform: rotate(90deg); margin: 20px 0; text-align: center; }
        .refund-detail-box { padding: 30px 20px; }
    }
</style>

