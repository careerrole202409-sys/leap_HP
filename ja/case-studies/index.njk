        hero_desc3: "導入検討の際の参考に、たくさんの事例を公開しています。",
        filter_title: "業界・サイトを絞り込む",
        industry_label: "業種",
        site_type_label: "サイト種類",
        no_results: "該当する事例は見つかりませんでした。"
    },
    en: {
        hero_title: "Case Studies of Leap Users",
        hero_desc1: "Why do companies choose to go multilingual, and what are their goals?",
        hero_desc2: "What challenges did they face, how did they solve them, and what results did they achieve?",
        hero_desc3: "We have published many case studies to help you consider introducing our service.",
        filter_title: "Filter by Industry and Site Type",
        industry_label: "Industry",
        site_type_label: "Site Type",
        no_results: "No matching case studies found."
    },
