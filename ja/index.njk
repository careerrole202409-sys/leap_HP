.hero-new {
    background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 40%, #fff0e8 100%);
    padding: 1.5rem 1rem;
}
.hero-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 55% 45%;
    gap: 1.5rem;
    align-items: center;
}
@media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-left  { order: 1; }
    .hero-btns  { order: 2; }
    .hero-stack { order: 3; padding-top: 4rem; max-width: 360px; margin: 0 auto; }
    .stack-img  { width: 75%; }
    .btn-hero-primary,
    .btn-hero-secondary {
        font-size: 1rem;
        padding: 0.85rem 2rem;
    }
    .hero-new h1 { font-size: 1.9rem; }
}
.hero-left { text-align: left; }
.hero-left .hero-sub {
    font-size: clamp(0.95rem, 1.8vw, 1.05rem);
    color: #555;
    line-height: 1.8;
    margin-bottom: 0;
}
.hero-btns {
    text-align: center;
    margin-top: 1.5rem;
    grid-column: 1 / -1;
}

/* ===== Stacked cards ===== */
.hero-stack {
    position: relative;
    padding-top: 7rem;
}
.stack-img {
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,0.07);
    display: block;
    width: 88%;
}
.stack-front {
    position: relative;
    z-index: 3;
    margin-left: 0;
    transform: rotate(-1deg);
    box-shadow: 0 16px 40px rgba(0,0,0,0.15);
}
.stack-mid {
    position: absolute;
    top: 3.5rem;
    left: 6%;
    z-index: 2;
    transform: rotate(1deg);
    opacity: 0.85;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
}
.stack-back {
    position: absolute;
    top: 0;
    left: 12%;
    z-index: 1;
    transform: rotate(3deg);
    opacity: 0.7;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
}
.hero-new h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: #1a1a2e;
    line-height: 1.15;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
}
.hero-new .hero-sub {
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: #555;
    max-width: 540px;
    margin: 0 auto 2rem;
    line-height: 1.8;
}
.btn-hero-primary {
    display: inline-block;
    background: linear-gradient(135deg, #C10033, #8B0024);
    color: #fff;
    font-size: 1.3rem;
    font-weight: 700;
    padding: 1.15rem 3.5rem;
    border-radius: 100px;
    text-decoration: none;
    transition: opacity 0.2s;
    margin: 0.4rem;
}
.btn-hero-primary:hover { opacity: 0.85; }
.btn-hero-secondary {
    display: inline-block;
    background: #fff;
    color: #1a1a2e;
    font-size: 1.3rem;
    font-weight: 700;
    padding: 1.15rem 3.5rem;
    border-radius: 100px;
