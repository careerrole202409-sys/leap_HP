    border: 2px solid #e5e7eb;
    transition: border-color 0.2s;
    margin: 0.4rem;
}
.btn-hero-secondary:hover { border-color: #C10033; }

/* ===== Section common ===== */
.section-new {
    padding: 4rem 1.5rem;
}
.section-new .container {
    max-width: 1100px;
    margin: 0 auto;
}
.section-label {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #C10033;
    margin-bottom: 0.6rem;
    display: block;
}
.section-new h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 800;
    color: #1a1a2e;
    line-height: 1.25;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
}
.section-new .section-desc {
    font-size: 1rem;
    color: #666;
    line-height: 1.8;
    max-width: 520px;
}

/* ===== bg variants ===== */
.bg-soft { background: #fafafa; }
.bg-pink { background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 60%, #fff0e8 100%); }

/* ===== 3 Pillars ===== */
.pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
}
@media (max-width: 768px) { .pillars { grid-template-columns: 1fr; } }
.pillar-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    display: block;
    transition: box-shadow 0.2s, border-color 0.2s;
}
.pillar-card:hover {
    box-shadow: 0 8px 24px rgba(193,0,51,0.1);
    border-color: #C10033;
}
.pillar-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #C10033, #8B0024);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
}
.pillar-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a2e;
    margin-bottom: 0.4rem;
}
.pillar-card p {
    font-size: 0.875rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 0.6rem;
}
.pillar-link {
    font-size: 0.82rem;
    font-weight: 700;
    color: #C10033;
}

/* ===== 全機能グリッド ===== */
.all-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
}
@media (max-width: 992px) { .all-features-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 768px) { .all-features-grid { grid-template-columns: 1fr; } }
.feature-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
}
.feature-card-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #C10033, #8B0024);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
    flex-shrink: 0;
}
.feature-card h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1a1a2e;
    margin-bottom: 0.4rem;
}
.feature-card p {
    font-size: 0.875rem;
    color: #666;
    line-height: 1.65;
    flex: 1;
    margin-bottom: 1rem;
}
.btn-feature-link {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    color: #C10033;
    border: 1.5px solid #C10033;
    border-radius: 100px;
    padding: 0.4rem 1rem;
    text-decoration: none;
    align-self: flex-start;
    transition: background 0.15s, color 0.15s;
}
.btn-feature-link:hover { background: #C10033; color: #fff; }

/* ===== Feature sections ===== */
.feature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
}
.feature-row.reverse { direction: rtl; }
.feature-row.reverse > * { direction: ltr; }
@media (max-width: 768px) {
    .feature-row, .feature-row.reverse { grid-template-columns: 1fr; direction: ltr; gap: 1.5rem; }
}
.feature-img {
    width: 100%;
    border-radius: 14px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 6px 24px rgba(0,0,0,0.07);
}

/* ===== Accordion ===== */
.accordion { margin-top: 1.25rem; }
.accordion-item {
    border-top: 1px solid #e5e7eb;
    padding: 1rem 0;
}
.accordion-item:last-child { border-bottom: 1px solid #e5e7eb; }
.accordion-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    color: #1a1a2e;
    list-style: none;
    user-select: none;
}
.accordion-trigger::-webkit-details-marker { display: none; }
details[open] .accordion-trigger .acc-icon { transform: rotate(45deg); }
.acc-icon {
    font-size: 1.3rem;
    color: #9ca3af;
    transition: transform 0.2s;
    flex-shrink: 0;
}
.accordion-body {
    padding-top: 0.5rem;
    font-size: 0.9rem;
    color: #666;
    line-height: 1.7;
}

/* ===== Consulting (light-touch) ===== */
.consulting-block {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
}
.consulting-block h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
}
.consulting-block .section-desc {
    max-width: 100%;
    margin: 0 auto 1.25rem;
}

/* ===== How it works ===== */
.steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
    margin-top: 2rem;
}
@media (max-width: 768px) { .steps { grid-template-columns: 1fr 1fr; } }
.step { text-align: center; }
.step-num {
    width: 52px;
    height: 52px;
    background: linear-gradient(135deg, #C10033, #8B0024);
    color: #fff;
    border-radius: 50%;
    font-size: 1.2rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.75rem;
}
.step h3 {
    font-size: 0.95rem;
    font-weight: 700;
    color: #1a1a2e;
    margin-bottom: 0.4rem;
}
.step p { font-size: 0.85rem; color: #666; line-height: 1.6; }

/* ===== Use cases tabs ===== */
.usecase-tabs {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
    margin-bottom: 2rem;
}
.usecase-tab {
    padding: 0.45rem 1.1rem;
    border-radius: 100px;
    border: 1px solid #e5e7eb;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    background: #fff;
    color: #555;
    transition: all 0.15s;
}
.usecase-tab.active { background: #1a1a2e; color: #fff; border-color: #1a1a2e; }
.usecase-content { display: none; }
.usecase-content.active {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
}
@media (max-width: 768px) { .usecase-content.active { grid-template-columns: 1fr; } }
.usecase-content h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #1a1a2e;
    margin-bottom: 0.6rem;
}
.usecase-content p {
    font-size: 0.9rem;
    color: #555;
    line-height: 1.75;
    margin-bottom: 1rem;
}
.usecase-list { list-style: none; padding: 0; }
.usecase-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #333;
    margin-bottom: 0.5rem;
}
.usecase-list li::before { content: "✓"; color: #C10033; font-weight: 700; flex-shrink: 0; }

@media (max-width: 768px) {
    .btn-hero-primary,
    .btn-hero-secondary {
        font-size: 1rem;
        padding: 0.85rem 2rem;
    }
}
