---
layout: base.njk
title: ノウハウ無料ダウンロード資料 | Leap
description: 海外展開に役立つ情報を無料でダウンロード。越境EC、海外マーケティング、海外営業のノウハウが詰まったLeapの資料集です。
---

<!-- 
  SECTION 1: HERO AREA 
-->
<section class="section py-3xl" style="background: var(--color-primary-gradient); color: var(--color-white);">
    <div class="container text-center">
        <h1 class="text-white mb-md">Leapノウハウ無料ダウンロード資料</h1>
        <p class="text-white mb-xl" style="font-size: var(--font-size-lg); max-width: 800px; margin-left: auto; margin-right: auto;">
            Leapの無料のお役立ち資料や製品を活用して、<br>
            海外展開、越境EC、海外マーケティングの成果最大化にお役立てください。
        </p>
        
        <div class="flex justify-center items-center" style="gap: var(--space-lg); flex-wrap: wrap;">
            <a href="#all-resources" class="btn btn-xl btn-white">
                すべての資料を見る ↓
            </a>
            <a href="https://app.leap.site" target="_blank" rel="noopener noreferrer" class="btn btn-xl btn-outline-white">
                ツールの無料お試しはこちら
            </a>
        </div>
    </div>
</section>

<!-- 
  SECTION 2: POPULAR RESOURCES (TABS)
-->
<section class="section py-xl bg-beige">
    <div class="container">
        <h2 class="text-center mb-lg" style="font-size: var(--font-size-3xl);">人気の資料集</h2>
        
        <!-- タブナビゲーション -->
        <div class="flex justify-center" style="border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-xl);">
            <nav style="display: flex; gap: var(--space-xl); overflow-x: auto; padding-bottom: 0;">
                
                <div onclick="switchTab('region')" class="tab-btn active" id="btn-region" 
                     style="padding-bottom: var(--space-sm); border-bottom: 3px solid var(--color-primary-start); color: var(--color-primary-start); font-weight: bold; cursor: pointer; font-size: 1rem; white-space: nowrap;">
                    国・地域別
                </div>
                
                <div onclick="switchTab('ec')" class="tab-btn" id="btn-ec" 
                     style="padding-bottom: var(--space-sm); border-bottom: 3px solid transparent; color: var(--color-text-secondary); cursor: pointer; font-size: 1rem; white-space: nowrap;">
                    越境EC
                </div>
                
                <div onclick="switchTab('marketing')" class="tab-btn" id="btn-marketing" 
                     style="padding-bottom: var(--space-sm); border-bottom: 3px solid transparent; color: var(--color-text-secondary); cursor: pointer; font-size: 1rem; white-space: nowrap;">
                    海外マーケティング
                </div>
                
                <div onclick="switchTab('sales')" class="tab-btn" id="btn-sales" 
                     style="padding-bottom: var(--space-sm); border-bottom: 3px solid transparent; color: var(--color-text-secondary); cursor: pointer; font-size: 1rem; white-space: nowrap;">
                    海外営業
                </div>

            </nav>
        </div>

        <!-- 
          タブコンテンツエリア 
          【修正】インラインスタイルの min-height: 500px を削除しました。
          代わりに下部の <style> タグで全タブ共通の高さ設定を行っています。
        -->

        <!-- 1. 国・地域別 (region) -->
        <div id="tab-content-region" class="tab-content grid-3">
            {% set topic_posts = collections.resource | selectattr("data.topic", "equalto", "region") | reverse %}
            {% set count = 0 %}

            {% for post in topic_posts %}
                {% if post.data.locale == 'ja' and count < 3 %}
                    <article class="card p-0" style="padding: 0; overflow: hidden; display: flex; flex-direction: column; border: 1px solid var(--color-border); box-shadow: none;">
                        <div style="background-color: var(--color-background); height: 160px; display: flex; align-items: center; justify-content: center;">
                            <span style="font-size: 3rem;">{{ post.data.icon | default('📄') }}</span>
                        </div>
                        <div class="px-lg py-lg flex-col" style="flex: 1; display: flex;">
                            <span class="text-light font-bold mb-sm" style="font-size: var(--font-size-xs); text-transform: uppercase;">{{ post.data.type }}</span>
                            <h3 style="font-size: var(--font-size-lg); margin-bottom: var(--space-sm);">{{ post.data.title }}</h3>
                            <p class="text-secondary mb-lg" style="flex: 1; font-size: var(--font-size-sm);">{{ post.data.description }}</p>
                            <a href="{{ post.url }}" class="text-primary font-bold">ダウンロードする &rarr;</a>
                        </div>
                    </article>
                    {% set count = count + 1 %}
                {% endif %}
            {% endfor %}

            {% if count == 0 %}
                <div class="text-center w-full flex items-center justify-center" style="grid-column: 1/-1; height: 100%;">
                    <p class="text-secondary">現在準備中です。</p>
                </div>
            {% endif %}
        </div>

        <!-- 2. 越境EC (ec) -->
        <div id="tab-content-ec" class="tab-content grid-3 hidden">
            {% set topic_posts = collections.resource | selectattr("data.topic", "equalto", "ec") | reverse %}
            {% set count = 0 %}

            {% for post in topic_posts %}
                {% if post.data.locale == 'ja' and count < 3 %}
                    <article class="card p-0" style="padding: 0; overflow: hidden; display: flex; flex-direction: column; border: 1px solid var(--color-border); box-shadow: none;">
                        <div style="background-color: var(--color-background); height: 160px; display: flex; align-items: center; justify-content: center;">
                            <span style="font-size: 3rem;">{{ post.data.icon | default('🛒') }}</span>
                        </div>
                        <div class="px-lg py-lg flex-col" style="flex: 1; display: flex;">
                            <span class="text-light font-bold mb-sm" style="font-size: var(--font-size-xs); text-transform: uppercase;">{{ post.data.type }}</span>
                            <h3 style="font-size: var(--font-size-lg); margin-bottom: var(--space-sm);">{{ post.data.title }}</h3>
                            <p class="text-secondary mb-lg" style="flex: 1; font-size: var(--font-size-sm);">{{ post.data.description }}</p>
                            <a href="{{ post.url }}" class="text-primary font-bold">ダウンロードする &rarr;</a>
                        </div>
                    </article>
                    {% set count = count + 1 %}
                {% endif %}
            {% endfor %}

            {% if count == 0 %}
                <div class="text-center w-full flex items-center justify-center" style="grid-column: 1/-1; height: 100%;">
                    <p class="text-secondary">現在準備中です。</p>
                </div>
            {% endif %}
        </div>

        <!-- 3. 海外マーケティング (marketing) -->
        <div id="tab-content-marketing" class="tab-content grid-3 hidden">
            {% set topic_posts = collections.resource | selectattr("data.topic", "equalto", "marketing") | reverse %}
            {% set count = 0 %}

            {% for post in topic_posts %}
                {% if post.data.locale == 'ja' and count < 3 %}
                    <article class="card p-0" style="padding: 0; overflow: hidden; display: flex; flex-direction: column; border: 1px solid var(--color-border); box-shadow: none;">
                        <div style="background-color: var(--color-background); height: 160px; display: flex; align-items: center; justify-content: center;">
                            <span style="font-size: 3rem;">{{ post.data.icon | default('📈') }}</span>
                        </div>
                        <div class="px-lg py-lg flex-col" style="flex: 1; display: flex;">
                            <span class="text-light font-bold mb-sm" style="font-size: var(--font-size-xs); text-transform: uppercase;">{{ post.data.type }}</span>
                            <h3 style="font-size: var(--font-size-lg); margin-bottom: var(--space-sm);">{{ post.data.title }}</h3>
                            <p class="text-secondary mb-lg" style="flex: 1; font-size: var(--font-size-sm);">{{ post.data.description }}</p>
                            <a href="{{ post.url }}" class="text-primary font-bold">ダウンロードする &rarr;</a>
                        </div>
                    </article>
                    {% set count = count + 1 %}
                {% endif %}
            {% endfor %}

            {% if count == 0 %}
                <div class="text-center w-full flex items-center justify-center" style="grid-column: 1/-1; height: 100%;">
                    <p class="text-secondary">現在準備中です。</p>
                </div>
            {% endif %}
        </div>

        <!-- 4. 海外営業 (sales) -->
        <div id="tab-content-sales" class="tab-content grid-3 hidden">
            {% set topic_posts = collections.resource | selectattr("data.topic", "equalto", "sales") | reverse %}
            {% set count = 0 %}

            {% for post in topic_posts %}
                {% if post.data.locale == 'ja' and count < 3 %}
                    <article class="card p-0" style="padding: 0; overflow: hidden; display: flex; flex-direction: column; border: 1px solid var(--color-border); box-shadow: none;">
                        <div style="background-color: var(--color-background); height: 160px; display: flex; align-items: center; justify-content: center;">
                            <span style="font-size: 3rem;">{{ post.data.icon | default('💼') }}</span>
                        </div>
                        <div class="px-lg py-lg flex-col" style="flex: 1; display: flex;">
                            <span class="text-light font-bold mb-sm" style="font-size: var(--font-size-xs); text-transform: uppercase;">{{ post.data.type }}</span>
                            <h3 style="font-size: var(--font-size-lg); margin-bottom: var(--space-sm);">{{ post.data.title }}</h3>
                            <p class="text-secondary mb-lg" style="flex: 1; font-size: var(--font-size-sm);">{{ post.data.description }}</p>
                            <a href="{{ post.url }}" class="text-primary font-bold">ダウンロードする &rarr;</a>
                        </div>
                    </article>
                    {% set count = count + 1 %}
                {% endif %}
            {% endfor %}

            {% if count == 0 %}
                <div class="text-center w-full flex items-center justify-center" style="grid-column: 1/-1; height: 100%;">
                    <p class="text-secondary">現在準備中です。</p>
                </div>
            {% endif %}
        </div>

    </div>
</section>

<!-- 
  SECTION 3: ALL RESOURCES (FILTER & GRID)
-->
<section id="all-resources" class="section py-3xl bg-white">
    <div class="container">
        <h2 class="text-center mb-sm">すべての資料を見る</h2>
        <p class="page-subtitle mb-2xl">海外売上を拡大させる無料資料集</p>

        <!-- Filters -->
        <div class="grid-3 mb-2xl">
            <div class="form-group mb-0">
                <label class="form-label" for="topic-select">トピック</label>
                <select id="topic-select" class="form-control" onchange="applyFilters()">
                    <option value="all">すべてのトピック</option>
                    <option value="region">国・地域別</option>
                    <option value="ec">越境EC</option>
                    <option value="marketing">海外マーケティング</option>
                    <option value="sales">海外営業</option>
                </select>
            </div>
            <div class="form-group mb-0">
                <label class="form-label" for="content-type-select">コンテンツ形式</label>
                <select id="content-type-select" class="form-control" onchange="applyFilters()">
                    <option value="all">すべての種類</option>
                    <option value="guide">ガイドブック</option>
                    <option value="template">テンプレート</option>
                    <option value="report">調査レポート</option>
                    <option value="checklist">チェックリスト</option>
                    <option value="tool">Excelツール</option>
                </select>
            </div>
            <div class="form-group mb-0">
                <label class="form-label" for="file-format-select">ファイル形式</label>
                <select id="file-format-select" class="form-control" onchange="applyFilters()">
                    <option value="all">すべてのファイル形式</option>
                    <option value="pdf">PDF</option>
                    <option value="excel">Excel</option>
                    <option value="ppt">PowerPoint</option>
                </select>
            </div>
        </div>

        <p id="result-count" class="text-right text-light mb-lg" style="font-size: var(--font-size-sm);">読み込み中...</p>

        <!-- Resources Grid -->
        <div class="grid-3" id="resources-grid">
            {% for post in collections.resource | reverse %}
                {% if post.data.locale == 'ja' %}
                    <div class="card p-0 resource-item" 
                         data-topic="{{ post.data.topic }}" 
                         data-type="{{ post.data.type }}" 
                         data-format="{{ post.data.format }}" 
                         style="padding: 0; border: 1px solid var(--color-border); box-shadow: none;">
                        
                        <div style="background-color: var(--color-background); height: 160px; display: flex; align-items: center; justify-content: center;">
                            <span style="font-size: 3rem;">{{ post.data.icon | default('📄') }}</span>
                        </div>
                        
                        <div class="px-lg py-lg">
                            <span class="mb-sm d-block" style="display:inline-block; background:var(--color-background); padding: 4px 8px; border-radius: 4px; font-size: 12px; text-transform: uppercase;">
                                {{ post.data.type }}
                            </span>
                            <h3 style="font-size: var(--font-size-lg);">{{ post.data.title }}</h3>
                            <p class="text-secondary" style="font-size: var(--font-size-sm);">
                                {{ post.data.description }}
                            </p>
                            <a href="{{ post.url }}" class="btn btn-primary w-full mt-md">無料ダウンロード</a>
                        </div>
                    </div>
                {% endif %}
            {% else %}
                <div class="text-center py-xl" style="grid-column: 1 / -1;">
                    <p>現在、資料はありません。</p>
                </div>
            {% endfor %}
        </div>

    </div>
</section>

<!-- 
  SECTION 4: CTA
-->
<section class="section py-3xl text-white" style="background-color: #26000a;">
    <div class="container">
        <div class="grid-2 items-center" style="gap: var(--space-3xl);">
            <div style="position: relative; display: flex; align-items: center; justify-content: center;">
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 120%; height: 120%; background: var(--color-primary-gradient); border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; z-index: 0; opacity: 0.8; max-width: 550px;"></div>
                <div style="position: relative; z-index: 1; width: 100%; max-width: 500px; aspect-ratio: 4 / 3; margin: 0 auto;">
                    <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Leap business scene" class="img-cover" style="width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-2xl);">
                </div>
            </div>
            <div class="text-left">
                <h2 class="text-white mb-lg" style="font-size: var(--font-size-3xl);">海外売上を伸ばすための<br>オールインワンツール</h2>
                <p class="mb-lg text-white" style="font-size: var(--font-size-lg); line-height: 1.6; font-weight: var(--font-weight-medium);">お探しのリソースは見つかりましたか？次は実践です。<br>Leapは、海外ビジネスの成功に必要な機能をひとつに統合したプラットフォームです。</p>
                <p class="mb-xl text-white" style="font-size: var(--font-size-base); line-height: 1.8; opacity: 0.9;">多言語HP作成、越境ECの開設・運用、多言語コンテンツ制作、海外向けSNS運用、そして現地の代理店マッチングまで。<br>Leapなら、複雑な海外展開のプロセスを一元管理し、効率的に海外売上を拡大させることができます。</p>
                <a href="https://app.leap.site" target="_blank" rel="noopener noreferrer" class="btn btn-lg" style="background: var(--color-primary-gradient); color: white; border: 1px solid rgba(255,255,255,0.2); box-shadow: 0 4px 14px 0 rgba(193, 0, 51, 0.4);">無料で始める</a>
            </div>
        </div>
    </div>
</section>

<!-- SCRIPTS -->
<script>
    // 1. タブ切り替え
    function switchTab(topic) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
        const targetContent = document.getElementById('tab-content-' + topic);
        if(targetContent) targetContent.classList.remove('hidden');

        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.style.borderBottom = '3px solid transparent';
            btn.style.color = 'var(--color-text-secondary)';
            btn.classList.remove('active');
        });
        
        const activeBtn = document.getElementById('btn-' + topic);
        if(activeBtn) {
            activeBtn.style.borderBottom = '3px solid var(--color-primary-start)';
            activeBtn.style.color = 'var(--color-primary-start)';
            activeBtn.classList.add('active');
        }
    }

    // 2. 絞り込み
    document.addEventListener('DOMContentLoaded', function() {
        applyFilters();
    });

    function applyFilters() {
        const topic = document.getElementById('topic-select').value;
        const type = document.getElementById('content-type-select').value;
        const format = document.getElementById('file-format-select').value;
        
        const items = document.querySelectorAll('#resources-grid .resource-item');
        let visibleCount = 0;
        let totalCount = 0;

        items.forEach(item => {
            totalCount++;
            const itemTopic = item.getAttribute('data-topic');
            const itemType = item.getAttribute('data-type');
            const itemFormat = item.getAttribute('data-format');

            const matchesTopic = (topic === 'all' || itemTopic === topic);
            const matchesType = (type === 'all' || itemType === type);
            const matchesFormat = (format === 'all' || itemFormat === format);

            if (matchesTopic && matchesType && matchesFormat) {
                item.style.display = 'block';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        const countElement = document.getElementById('result-count');
        if (countElement) {
            countElement.textContent = `全 ${totalCount} 資料中の ${visibleCount} 件を表示中`;
        }
    }
</script>

<style>
    .hidden { display: none !important; }
    
    /* 
       【修正点】
       すべてのタブコンテンツエリアの高さを統一してジャンプを防止。
       500pxだと大きすぎたので、300px程度に調整。
    */
    .tab-content {
        min-height: 300px;
    }
</style>