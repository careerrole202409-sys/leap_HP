    z-index: 3;
    margin-left: 0;
    transform: rotate(-1deg);
    box-shadow: 0 16px 40px rgba(0,0,0,0.15);
}
.stack-mid {
    position: absolute;
    top: 4.5rem;
    left: 6%;
    z-index: 2;
    transform: rotate(1deg);
    opacity: 0.85;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
}
.stack-back {
    position: absolute;
    top: 0;
    left: 12%;
