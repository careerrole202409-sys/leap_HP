    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
}
.pillar-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a2e;
    margin-bottom: 0.4rem;
