<style>
/* ===== Hero ===== */
.hero-new {
    background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 40%, #fff0e8 100%);
    padding: 1.5rem 1rem;
}
.hero-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 55% 45%;
    gap: 1.5rem;
    align-items: center;
}
@media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-left  { order: 1; }
    .hero-btns  { order: 2; }
    .hero-stack { order: 3; padding-top: 4rem; max-width: 360px; margin: 0 auto; }
    .stack-img  { width: 75%; }
    .btn-hero-primary,
    .btn-hero-secondary {
        font-size: 1rem;
        padding: 0.85rem 2rem;
    }
    .hero-new h1 { font-size: 1.9rem; }
}
.hero-left { text-align: left; }
.hero-left .hero-sub {
    font-size: clamp(0.95rem, 1.8vw, 1.05rem);
    color: #555;
    line-height: 1.8;
    max-width: none;
    margin: 0; /* 見出しと左端を揃える */
}
.hero-btns {
    text-align: center;
    margin-top: 1.5rem;
    grid-column: 1 / -1;
}

/* ===== Stacked cards ===== */
.hero-stack {
    position: relative;
    padding-top: 7rem;
}
.stack-img {
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,0.07);
    display: block;
    width: 88%;
}
.stack-front {
    position: relative;
    z-index: 3;
    margin-left: 0;
    transform: rotate(-1deg);
    box-shadow: 0 16px 40px rgba(0,0,0,0.15);
}
.stack-mid {
    position: absolute;
    top: 3.5rem;
    left: 6%;
    z-index: 2;
    transform: rotate(1deg);
    opacity: 0.85;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
}
.stack-back {
    position: absolute;
    top: 0;
    left: 12%;
    z-index: 1;
    transform: rotate(3deg);
    opacity: 0.7;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
}
.hero-new h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: #1a1a2e;
    line-height: 1.15;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
}
.hero-new .hero-sub {
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: #555;
    max-width: 540px;
    margin: 0 auto 2rem;
    line-height: 1.8;
}
.btn-hero-primary {
    display: inline-block;
    background: linear-gradient(135deg, #C10033, #8B0024);
    color: #fff;
    font-size: 1.3rem;
    font-weight: 700;
    padding: 1.15rem 3.5rem;
    border-radius: 100px;
    text-decoration: none;
    transition: opacity 0.2s;
    margin: 0.4rem;
}
.btn-hero-primary:hover { opacity: 0.85; }
.btn-hero-secondary {
    display: inline-block;
    background: #fff;
    color: #1a1a2e;
    font-size: 1.3rem;
    font-weight: 700;
    padding: 1.15rem 3.5rem;
    border-radius: 100px;
    text-decoration: none;
    border: 2px solid #e5e7eb;
    transition: border-color 0.2s;
    margin: 0.4rem;
}
.btn-hero-secondary:hover { border-color: #C10033; }

/* ===== Section common ===== */
.section-new {
    padding: 4rem 1.5rem;
}
.section-new .container {
    max-width: 1100px;
    margin: 0 auto;
}
.section-label {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #C10033;
    margin-bottom: 0.6rem;
    display: block;
}
.section-new h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 800;
    color: #1a1a2e;
    line-height: 1.25;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
}
.section-new .section-desc {
    font-size: 1rem;
    color: #666;
    line-height: 1.8;
    max-width: 520px;
}

/* ===== bg variants ===== */
.bg-soft { background: #fafafa; }
.bg-gray { background: #f1f3f6; }
.bg-pink { background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 60%, #fff0e8 100%); }

/* ===== 3 Pillars ===== */
.pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
}
@media (max-width: 768px) { .pillars { grid-template-columns: 1fr; } }
.pillar-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    display: block;
    transition: box-shadow 0.2s, border-color 0.2s;
}
.pillar-card:hover {
    box-shadow: 0 8px 24px rgba(193,0,51,0.1);
    border-color: #C10033;
}
/* リンクではないカードは、クリックできるように見せない */
div.pillar-card:hover { box-shadow: none; border-color: #e5e7eb; }
.pillar-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #C10033, #8B0024);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
}
.pillar-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a2e;
    margin-bottom: 0.4rem;
}
.pillar-card p {
    font-size: 0.875rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 0.6rem;
}
.pillar-link {
    font-size: 0.82rem;
    font-weight: 700;
    color: #C10033;
}

/* ===== Feature sections ===== */
.feature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
}
.feature-row.reverse { direction: rtl; }
.feature-row.reverse > * { direction: ltr; }
@media (max-width: 768px) {
    .feature-row, .feature-row.reverse { grid-template-columns: 1fr; direction: ltr; gap: 1.5rem; }
}
.feature-img {
    width: 100%;
    border-radius: 14px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 6px 24px rgba(0,0,0,0.07);
}

/* ===== Accordion ===== */
.accordion { margin-top: 1.25rem; }
.accordion-item {
    border-top: 1px solid #e5e7eb;
    padding: 1rem 0;
}
.accordion-item:last-child { border-bottom: 1px solid #e5e7eb; }
.accordion-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    color: #1a1a2e;
    list-style: none;
    user-select: none;
}
.accordion-trigger::-webkit-details-marker { display: none; }
details[open] .accordion-trigger .acc-icon { transform: rotate(45deg); }
.acc-icon {
    font-size: 1.3rem;
    color: #9ca3af;
    transition: transform 0.2s;
    flex-shrink: 0;
}
.accordion-body {
    padding-top: 0.5rem;
    font-size: 0.9rem;
    color: #666;
    line-height: 1.7;
}

/* ===== テンプレート ===== */
.top-tpl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
}
@media (max-width: 900px) { .top-tpl-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) {
    .top-tpl-grid { gap: 0.75rem; }
    .top-tpl-body { flex-direction: column; align-items: flex-start; gap: 0.35rem; padding: 0.6rem 0.75rem 0.75rem; }
    .top-tpl-name { font-size: 0.85rem; }
}
.top-tpl-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.top-tpl-card:hover { transform: translateY(-4px); box-shadow: 0 12px 26px rgba(0,0,0,0.1); }
.top-tpl-img { aspect-ratio: 16 / 10; overflow: hidden; background: #f4f5f8; }
.top-tpl-img img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
.top-tpl-body { padding: 0.85rem 1.1rem 1rem; display: flex; align-items: center; gap: 0.6rem; }
.top-tpl-type {
    flex-shrink: 0;
    background: #fef2f2;
    color: #C10033;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 20px;
    border: 1px solid #fecdd3;
}
.top-tpl-name { font-size: 0.95rem; font-weight: 700; color: #1a1a2e; }
.top-tpl-card:hover .top-tpl-name { color: #C10033; }
.top-more { text-align: center; margin-top: 2rem; }
.top-more a {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 700;
    color: #C10033;
    border: 1.5px solid #C10033;
    border-radius: 100px;
    padding: 0.6rem 1.5rem;
    text-decoration: none;
    background: #fff;
    transition: background 0.15s, color 0.15s;
}
.top-more a:hover { background: #C10033; color: #fff; }

/* ===== 導入事例 ===== */
.top-case-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
}
@media (max-width: 900px) { .top-case-grid { grid-template-columns: 1fr; max-width: 520px; margin-left: auto; margin-right: auto; } }
.top-case-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.top-case-card:hover { transform: translateY(-4px); box-shadow: 0 12px 26px rgba(0,0,0,0.08); }
.top-case-logo {
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    border-bottom: 3px solid #C10033;
}
.top-case-logo img { max-width: 70%; max-height: 80px; object-fit: contain; }
.top-case-body { padding: 1.1rem 1.25rem 1.3rem; }
.top-case-company { font-size: 0.85rem; color: #64748b; margin-bottom: 0.35rem; }
.top-case-title { font-size: 1rem; font-weight: 700; line-height: 1.55; color: #1a1a2e; margin: 0; }
.top-case-card:hover .top-case-title { color: #C10033; }

/* ===== よくある質問 ===== */
.top-faq { max-width: 820px; margin: 2rem auto 0; display: flex; flex-direction: column; gap: 0.75rem; }
.top-faq details {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.1rem 1.4rem;
}
.top-faq summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    list-style: none;
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a2e;
}
.top-faq summary::-webkit-details-marker { display: none; }
.top-faq summary::before { content: "Q"; flex-shrink: 0; font-weight: 800; color: #C10033; font-size: 1.1rem; }
.top-faq summary .acc-icon { margin-left: auto; }
.top-faq details[open] summary .acc-icon { transform: rotate(45deg); }
.top-faq-answer { padding: 0.85rem 0 0 1.85rem; font-size: 0.95rem; color: #475569; line-height: 1.8; }
.top-faq-answer dl { display: grid; grid-template-columns: auto 1fr; gap: 0.35rem 1rem; margin: 0.6rem 0 0; }
.top-faq-answer dt { font-weight: 700; color: #1a1a2e; white-space: nowrap; }
.top-faq-answer dd { margin: 0; }
@media (max-width: 560px) {
    .top-faq-answer { padding-left: 0; }
    .top-faq-answer dl { grid-template-columns: 1fr; gap: 0 0; }
    .top-faq-answer dd { margin-bottom: 0.5rem; }
}

/* ===== お悩み（課題提起） ===== */
.pain-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-top: 2rem;
}
@media (max-width: 900px) { .pain-grid { grid-template-columns: repeat(2, 1fr); } }
.pain-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 1.5rem 1.25rem;
    text-align: center;
}
.pain-icon {
    width: 44px;
    height: 44px;
    margin: 0 auto 0.85rem;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #e5e7eb;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
}
.pain-card p {
    font-size: 0.95rem;
    font-weight: 700;
    color: #1a1a2e;
    line-height: 1.6;
    margin: 0;
}
@media (max-width: 600px) {
    .pain-card { padding: 1.25rem 0.75rem; }
    .pain-card p { font-size: 0.85rem; }
    .pain-card p br { display: none; }
}
/* ===== 機能の全体像（制作 → 集客 → 管理 → BtoBで拡大する成長曲線） ===== */
.section-growth { padding: 2.75rem 1.5rem 3rem; }
.section-growth h2 { margin-bottom: 0; }
/* Leapの枠：図全体を包み、左上の線にロゴを載せる */
.growth-frame {
    position: relative;
    margin-top: 1.75rem;
    padding: 1.5rem 1.5rem 1rem 1.5rem;
    background: #fff;
    border: 1.5px solid #e9a8b8;
    border-radius: 18px;
    box-shadow: 0 10px 30px rgba(193, 0, 51, 0.08);
}
.growth-badge {
    position: absolute;
    top: 0;
    left: 24px;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 14px 5px 8px;
    background: #fff;
    border: 1.5px solid #e9a8b8;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 800;
    color: #C10033;
    letter-spacing: 0.02em;
    line-height: 1;
}
.growth-badge img { width: 22px; height: 22px; object-fit: contain; }
.growth {
    position: relative;
    aspect-ratio: 1000 / 380;
    max-height: 380px;
    min-height: 340px;
    background-image:
        linear-gradient(#eceff4 1px, transparent 1px),
        linear-gradient(90deg, #eceff4 1px, transparent 1px);
    background-size: 100% 25%, 12.5% 100%;
    border-left: 2px solid #475569;
    border-bottom: 2px solid #475569;
}
/* 軸の矢印 */
.growth::before,
.growth::after {
    content: "";
    position: absolute;
    width: 0;
    height: 0;
    border: 6px solid transparent;
}
.growth::before { left: -7px; top: -10px; border-bottom: 9px solid #475569; border-top: 0; }
.growth::after  { right: -10px; bottom: -7px; border-left: 9px solid #475569; border-right: 0; }
.growth-axis {
    position: absolute;
    font-size: 0.95rem;
    font-weight: 700;
    color: #334155;
    white-space: nowrap;
}
.growth-axis.is-y { left: 12px; top: -6px; }
.growth-axis.is-x { right: 6px; bottom: 6px; }
.growth-line { position: absolute; inset: 0; width: 100%; height: 100%; }
.growth-node { position: absolute; width: 0; height: 0; }
.growth-node.is-create { left: 10%; top: 86%; --len: 96px; }
.growth-node.is-grow   { left: 36%; top: 76%; --len: 56px; }
.growth-node.is-manage { left: 62%; top: 58%; --len: 20px; }
.growth-node.is-btob   { left: 88%; top: 36%; --len: 30px; }
.growth-dot {
    position: absolute;
    left: -7px;
    top: -7px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #C10033;
    box-shadow: 0 0 0 4px #fff, 0 2px 8px rgba(193, 0, 51, 0.35);
    z-index: 2;
}
/* 点から引き出す線 */
.growth-node::before {
    content: "";
    position: absolute;
    left: 0;
    height: var(--len);
    border-left: 2px dashed #b6bfcc;
    transform: translateX(-1px);
}
.growth-node.is-up::before   { bottom: 0; }
.growth-node.is-down::before { top: 0; }
.growth-callout {
    position: absolute;
    left: -14px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 0.6rem 0.75rem 0.7rem;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
    white-space: nowrap;
}
.growth-node.is-up .growth-callout   { bottom: var(--len); }
.growth-node.is-down .growth-callout { top: var(--len); }
/* 右端は左向きに開く */
.growth-node.is-left .growth-callout { left: auto; right: -14px; }
.growth-callout.is-inline { display: flex; align-items: center; gap: 6px; }
.growth-callout.is-inline .growth-callout-title { margin-bottom: 0; }
.growth-callout-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #C10033;
    margin: 0 0 0.45rem 2px;
}
.growth-chips { display: flex; flex-direction: column; align-items: stretch; gap: 5px; }
/* 機能ページへのリンク（押せるチップ） */
.growth-chip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 3px 10px 3px 12px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
    color: #1a1a2e;
    background: #f8fafc;
    border: 1px solid #dfe4eb;
    border-radius: 7px;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
}
a.growth-chip::after { content: "\203A"; font-size: 1.05rem; line-height: 1; color: #94a3b8; transition: color 0.15s; }
a.growth-chip:hover { color: #C10033; border-color: #C10033; background: #fff; }
a.growth-chip:hover::after { color: #C10033; }
/* ページがない項目はチップにしない */
span.growth-chip { background: none; border-color: transparent; color: #64748b; font-weight: 500; padding-left: 2px; }
/* タブレット・スマホ：曲線と軸を外し、縦の流れに */
@media (max-width: 1023px) {
    .growth-frame { padding: 1.8rem 1.1rem 1.1rem; }
    .growth {
        aspect-ratio: auto;
        max-height: none;
        background: none;
        border-bottom: 0;
        border-left: 2px solid #C10033;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        padding-left: 20px;
        margin-left: 7px;
    }
    .growth::before, .growth::after, .growth-axis, .growth-line { display: none; }
    .growth-node { position: relative; left: auto !important; top: auto !important; width: auto; height: auto; }
    .growth-node::before { display: none; }
    .growth-dot { left: -28px; top: 15px; }
    .growth-callout,
    .growth-node.is-left .growth-callout { position: static; white-space: normal; }
    .growth-chips { display: flex; flex-direction: row; flex-wrap: wrap; }
}
</style>

