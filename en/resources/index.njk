---
layout: base.njk
title: Free Downloadable Resources | Leap
description: Download free guides and insights on cross-border e-commerce, global marketing, and international sales to grow your business.
---

<!-- 
  SECTION 1: HERO AREA 
-->
<section class="section py-3xl" style="background: var(--color-primary-gradient); color: var(--color-white);">
    <div class="container text-center">
        <h1 class="text-white mb-md">Leap Free Resources & Guides</h1>
        <p class="text-white mb-xl" style="font-size: var(--font-size-lg); max-width: 800px; margin-left: auto; margin-right: auto;">
            Maximize your success in global expansion, cross-border e-commerce, <br>
            and international marketing with Leap's free guides and tools.
        </p>
        
        <div class="flex justify-center items-center" style="gap: var(--space-lg); flex-wrap: wrap;">
            <a href="#resources-section" class="btn btn-xl btn-white">
                View All Resources ↓
            </a>
            <a href="https://app.leap.site" target="_blank" rel="noopener noreferrer" class="btn btn-xl btn-outline-white">
                Try Our Tool for Free
            </a>
        </div>
    </div>
</section>

<!-- 
  SECTION 2: RESOURCES MAIN (MERGED)
-->
<section id="resources-section" class="section py-xl bg-beige">
    <div class="container">
        <h2 class="text-center mb-lg" style="font-size: var(--font-size-3xl);">Resource Library</h2>
        
        <!-- Tab Navigation -->
        <div class="flex justify-center" style="border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-xl);">
            <nav style="display: flex; gap: var(--space-xl); overflow-x: auto; padding-bottom: 0;">
                
                <!-- All -->
                <div onclick="filterResources('all')" class="tab-btn active" id="btn-all" 
                     style="padding-bottom: var(--space-sm); border-bottom: 3px solid var(--color-primary-start); color: var(--color-primary-start); font-weight: bold; cursor: pointer; font-size: 1rem; white-space: nowrap;">
                    All
                </div>

                <!-- By Region -->
                <div onclick="filterResources('region')" class="tab-btn" id="btn-region" 
                     style="padding-bottom: var(--space-sm); border-bottom: 3px solid transparent; color: var(--color-text-secondary); cursor: pointer; font-size: 1rem; white-space: nowrap;">
                    By Region
                </div>
                
                <!-- Cross-border E-commerce -->
                <div onclick="filterResources('ec')" class="tab-btn" id="btn-ec" 
                     style="padding-bottom: var(--space-sm); border-bottom: 3px solid transparent; color: var(--color-text-secondary); cursor: pointer; font-size: 1rem; white-space: nowrap;">
                    Cross-border E-commerce
                </div>
                
                <!-- Global Marketing -->
                <div onclick="filterResources('marketing')" class="tab-btn" id="btn-marketing" 
                     style="padding-bottom: var(--space-sm); border-bottom: 3px solid transparent; color: var(--color-text-secondary); cursor: pointer; font-size: 1rem; white-space: nowrap;">
                    Global Marketing
                </div>
                
                <!-- Global Sales -->
                <div onclick="filterResources('sales')" class="tab-btn" id="btn-sales" 
                     style="padding-bottom: var(--space-sm); border-bottom: 3px solid transparent; color: var(--color-text-secondary); cursor: pointer; font-size: 1rem; white-space: nowrap;">
                    Global Sales
                </div>

            </nav>
        </div>

        <!-- 
          Resources Grid
          Outputs all resources; visibility is controlled by JS
        -->
        <div id="resources-grid" class="grid-3">
            {% set all_posts = collections.resource | reverse %}
            {% set has_posts = false %}

            {% for post in all_posts %}
                {# Changed locale check to 'en' #}
                {% if post.data.locale == 'en' %}
                    {% set has_posts = true %}
                    <a href="{{ post.url }}" 
                       class="resource-item card p-0" 
                       data-topic="{{ post.data.topic }}" 
                       style="padding: 0; overflow: hidden; display: flex; flex-direction: column; border: 1px solid var(--color-border); box-shadow: none; text-decoration: none; color: inherit;">
                        
                        <!-- Icon Area -->
                        <div style="background-color: var(--color-background); height: 160px; display: flex; align-items: center; justify-content: center;">
                            <span style="font-size: 3rem;">{{ post.data.icon | default('📄') }}</span>
                        </div>
                        
                        <!-- Content Area -->
                        <div class="px-lg py-lg flex-col" style="flex: 1; display: flex;">
                            <span class="text-light font-bold mb-sm" style="font-size: var(--font-size-xs); text-transform: uppercase;">
                                {{ post.data.type }}
                            </span>
                            <h3 style="font-size: var(--font-size-lg); margin-bottom: var(--space-sm);">
                                {{ post.data.title }}
                            </h3>
                            <p class="text-secondary mb-lg" style="flex: 1; font-size: var(--font-size-sm);">
                                {{ post.data.description }}
                            </p>
                            <span class="text-primary font-bold">
                                Download Now &rarr;
                            </span>
                        </div>
                    </a>
                {% endif %}
            {% endfor %}

            <!-- No Results Message -->
            <div id="no-results-message" class="text-center w-full flex items-center justify-center hidden" style="grid-column: 1/-1; padding: var(--space-2xl) 0;">
                <p class="text-secondary">No matching resources found.</p>
            </div>
        </div>

        {% if not has_posts %}
            <div class="text-center w-full flex items-center justify-center" style="padding: var(--space-2xl) 0;">
                <p class="text-secondary">There are currently no resources available.</p>
            </div>
        {% endif %}

    </div>
</section>

{% include "cta1.njk" %}

<!-- SCRIPTS -->
<script>
    /**
     * Filter Resources Function
     * @param {string} topic - Selected topic ('all', 'region', 'ec', 'marketing', 'sales')
     */
    function filterResources(topic) {
        // 1. Update tab styles
        const buttons = document.querySelectorAll('.tab-btn');
        buttons.forEach(btn => {
            btn.style.borderBottom = '3px solid transparent';
            btn.style.color = 'var(--color-text-secondary)';
            btn.style.fontWeight = 'normal';
            btn.classList.remove('active');
        });

        const activeBtn = document.getElementById('btn-' + topic);
        if (activeBtn) {
            activeBtn.style.borderBottom = '3px solid var(--color-primary-start)';
            activeBtn.style.color = 'var(--color-primary-start)';
            activeBtn.style.fontWeight = 'bold';
            activeBtn.classList.add('active');
        }

        // 2. Filter list items
        const items = document.querySelectorAll('.resource-item');
        let visibleCount = 0;

        items.forEach(item => {
            const itemTopic = item.getAttribute('data-topic');
            
            // Show if 'all' is selected or topic matches
            if (topic === 'all' || itemTopic === topic) {
                item.style.display = 'flex'; // Use flex to match card layout
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        // 3. Control "no results" message
        const noResultsMsg = document.getElementById('no-results-message');
        if (noResultsMsg) {
            if (visibleCount === 0) {
                noResultsMsg.classList.remove('hidden');
                noResultsMsg.style.display = 'flex';
            } else {
                noResultsMsg.classList.add('hidden');
                noResultsMsg.style.display = 'none';
            }
        }
    }

    // Initial load: 'All' is displayed by default (via HTML structure)
    document.addEventListener('DOMContentLoaded', () => {
        // Initialization if needed
    });
</script>

<style>
    .hidden { display: none !important; }
    
    /* Tab Hover Effect */
    .tab-btn:hover {
        color: var(--color-primary-start) !important;
    }
</style>