---
layout: base.njk
title: Help Center | Leap
description: From store setup and account management to product registration, payments, order and shipping handling, design and marketing, and security — find answers to common e-commerce operation questions here.
---

<!-- ▼ Hero Section -->
<section class="section py-3xl" style="background: var(--color-primary-gradient); color: var(--color-white);">
    <div class="container text-center">
        <span class="text-white font-bold mb-sm d-block" style="opacity: 0.9; letter-spacing: 0.05em;">Leap Knowledge Base</span>
        <h1 class="text-white mb-md">Help Center</h1>
        <p class="text-white mb-xl" style="font-size: var(--font-size-lg); max-width: 800px; margin-left: auto; margin-right: auto;">
            From store setup and account management to products, payments, orders and shipping,<br>
            design and marketing, and security — answers to the questions e-commerce operators run into most.
        </p>
    </div>
</section>

<!-- ▼ Category Cards -->
<section class="section bg-white" style="position: relative; margin-top: -60px; padding-top: var(--space-lg); padding-bottom: var(--space-3xl);">
    <div class="container">

        <div class="flex justify-end mb-md" style="position: relative; z-index: 10;">
            <a href="/{{ locale }}/help/list/" class="view-all-link">
                See all articles &rarr;
            </a>
        </div>

        <!-- 6 category cards -->
        <div class="grid-3" style="gap: 20px;">

            <!-- 1. Store Setup & Account -->
            <a href="/{{ locale }}/help/account-setup/" class="manual-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:32px; height:32px; color: var(--color-primary-start);"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                </div>
                <h2 class="manual-title">Store Setup & Account</h2>
                <p class="manual-desc">Pre-launch checks, editing your registration details, login help, and identity verification.</p>
                <span class="manual-link">Browse articles &rarr;</span>
            </a>

            <!-- 2. Products & Inventory -->
            <a href="/{{ locale }}/help/products/" class="manual-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:32px; height:32px; color: var(--color-primary-start);"><path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" /></svg>
                </div>
                <h2 class="manual-title">Products & Inventory</h2>
                <p class="manual-desc">Rules for what you can sell, restricted product categories, filters, and cross-border sales.</p>
                <span class="manual-link">Browse articles &rarr;</span>
            </a>

            <!-- 3. Payments & Payouts -->
            <a href="/{{ locale }}/help/payments/" class="manual-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:32px; height:32px; color: var(--color-primary-start);"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-13.5 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" /></svg>
                </div>
                <h2 class="manual-title">Payments & Payouts</h2>
                <p class="manual-desc">How payments work, business account applications, payout schedules, and error troubleshooting.</p>
                <span class="manual-link">Browse articles &rarr;</span>
            </a>

            <!-- 4. Orders, Shipping & Cancellations -->
            <a href="/{{ locale }}/help/orders/" class="manual-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:32px; height:32px; color: var(--color-primary-start);"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
                </div>
                <h2 class="manual-title">Orders, Shipping & Cancellations</h2>
                <p class="manual-desc">Order management basics, shipping setup, cancellations and refunds, and return troubleshooting.</p>
                <span class="manual-link">Browse articles &rarr;</span>
            </a>

            <!-- 5. Design, Marketing & Promotion -->
            <a href="/{{ locale }}/help/design-marketing/" class="manual-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:32px; height:32px; color: var(--color-primary-start);"><path stroke-linecap="round" stroke-linejoin="round" d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 1 1 0-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 0 1-1.44-4.282m3.102.069a18.03 18.03 0 0 1-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 0 1 8.835 2.535M10.34 6.66a23.847 23.847 0 0 1 8.835-2.535m0 0A23.74 23.74 0 0 0 18.795 3m.38 1.125a23.91 23.91 0 0 1 1.014 5.795 23.944 23.944 0 0 1-1.014 5.795m-3.8-11.58a23.917 23.917 0 0 0-4.636 2.02" /></svg>
                </div>
                <h2 class="manual-title">Design, Marketing & Promotion</h2>
                <p class="manual-desc">Customizing your store design, Instagram and Google integrations, and running coupons and sales.</p>
                <span class="manual-link">Browse articles &rarr;</span>
            </a>

            <!-- 6. Security & Trouble Response -->
            <a href="/{{ locale }}/help/security/" class="manual-card">
                <div class="icon-box">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width:32px; height:32px; color: var(--color-primary-start);"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
                </div>
                <h2 class="manual-title">Security & Trouble Response</h2>
                <p class="manual-desc">How chargebacks and fraud work, prevention tips, and what to do when a payment issue comes up.</p>
                <span class="manual-link">Browse articles &rarr;</span>
            </a>

        </div>
    </div>
</section>

<!-- ▼ Latest Articles -->
<section id="latest-articles-section" class="section py-xl bg-beige">
    <div class="container">

        <div class="flex justify-between items-center mb-lg" style="width: 100%; justify-content: space-between; gap: 20px;">
            <h2 id="section-title" class="text-xl font-bold" style="border-left: 5px solid var(--color-primary-start); padding-left: 15px;">Latest Articles</h2>
        </div>

        <div class="grid-3" id="posts-container">
            {% set displayed_count = 0 %}

            {% for post in collections['help'] | reverse %}
                {% if post.data.locale and post.data.locale == locale %}

                    {% set topic_label = help_topic_translation[post.data.topic][locale] %}
                    {% if not topic_label %}
                        {% set topic_label = post.data.topic_label | default(post.data.topic) %}
                    {% endif %}

                    <article class="card p-0 blog-item"
                             data-tags="{{ post.data.tags | join(',') }}"
                             style="padding: 0; overflow: hidden; display: {% if displayed_count < 6 %}flex{% else %}none{% endif %}; flex-direction: column; border: 1px solid var(--color-border); box-shadow: none; background: white; border-radius: 8px; transition: transform 0.2s;">

                        {% if post.data.thumbnail %}
                        <a href="{{ post.url }}" style="display: block; aspect-ratio: 16/9; overflow: hidden;">
                            <img src="{{ post.data.thumbnail }}"
                                 alt="{{ post.data.title }}"
                                 style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;">
                        </a>
                        {% endif %}

                        <div class="px-lg py-lg flex-col" style="flex: 1; display: flex;">
                            <div class="flex justify-between items-center mb-sm">
                                <span class="text-primary font-bold" style="font-size: 12px; background: rgba(193, 0, 51, 0.1); padding: 4px 8px; border-radius: 4px;">
                                    {{ topic_label }}
                                </span>
                                <time style="font-size: 12px; color: var(--color-text-secondary);">
                                    {{ post.date | date("yyyy.MM.dd") }}
                                </time>
                            </div>

                            <h3 style="font-size: 1.1rem; margin-bottom: var(--space-sm); line-height: 1.4; font-weight: bold;">
                                <a href="{{ post.url }}" style="color: inherit; text-decoration: none;">
                                    {{ post.data.title }}
                                </a>
                            </h3>

                            <p class="text-secondary mb-lg" style="flex: 1; font-size: 0.9rem; line-height: 1.6; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;">
                                {{ post.data.description }}
                            </p>

                            <div class="flex items-center pt-sm" style="border-top: 1px solid #eee;">
                                <div style="width: 24px; height: 24px; border-radius: 50%; background: #ccc; margin-right: 8px; overflow: hidden;">
                                    <img src="{{ post.data.author_image | default('https://placehold.co/100x100/ddd/fff?text=User') }}" alt="author" style="width:100%; height:100%; object-fit:cover;">
                                </div>
                                <span style="font-size: 12px; font-weight: bold; color: var(--color-text-primary);">
                                    {{ post.data.author | default('Leap Editorial Team') }}
                                </span>
                            </div>
                        </div>
                    </article>
                    {% set displayed_count = displayed_count + 1 %}
                {% endif %}
            {% endfor %}

            {% if displayed_count == 0 %}
                <div class="text-center w-full py-3xl" style="grid-column: 1/-1;">
                    <p class="text-secondary">No articles yet.</p>
                </div>
            {% endif %}
        </div>

    </div>
</section>

{% include "cta1.njk" %}

<style>
    .view-all-link {
        color: var(--color-primary-start);
        font-weight: bold;
        text-decoration: none;
        font-size: 0.95rem;
        transition: transform 0.2s, opacity 0.2s;
        display: inline-block;
    }

    .view-all-link:hover {
        transform: translateX(5px);
        opacity: 0.8;
        text-decoration: underline;
    }

    .manual-card {
        display: block;
        background: white;
        padding: 30px 20px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        text-decoration: none;
        color: inherit;
        transition: transform 0.3s, box-shadow 0.3s;
        border: 1px solid rgba(0,0,0,0.05);
        text-align: center;
        height: 100%;
    }

    .manual-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        border-color: var(--color-primary-start);
    }

    .icon-box {
        background: #fff5f7;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .manual-title {
        font-size: 1.25rem;
        font-weight: bold;
        margin-bottom: 10px;
        color: var(--color-text-primary);
    }

    .manual-desc {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .manual-link {
        font-size: 0.9rem;
        font-weight: bold;
        color: var(--color-primary-start);
    }
</style>
