---
layout: base.njk
title: All Articles | Global Business Knowledge Base
description: A complete list of all articles in Leap's Global Business Knowledge Base.
---

<!-- ▼ Main Content -->
<section class="section pt-3xl pb-3xl bg-beige" style="min-height: 80vh;">
    <div class="container">

        <!-- Header: title, back link, sort -->
        <div class="flex justify-between items-end mb-lg flex-wrap" style="gap: 1rem;">

            <div class="flex items-center flex-wrap" style="gap: 1.5rem;">
                <h1 class="font-bold text-primary" style="font-size: 2rem; margin: 0; line-height: 1.2;">All Articles</h1>
                <a href="/{{ locale }}/blog/" class="back-to-top">
                    &larr; Back to Blog
                </a>
            </div>

            <!-- Sort -->
            <div class="flex items-center" style="font-size: 0.9rem;">
                <span class="text-secondary mr-sm">Sort by:</span>
                <button onclick="setSortType('date')" class="sort-btn active" id="sort-date">Latest</button>
                <span class="text-border mx-xs" style="color: var(--color-border);">|</span>
                <button onclick="setSortType('views')" class="sort-btn" id="sort-views">Popular</button>
            </div>
        </div>

        <!-- Category Filter Tabs -->
        <div class="flex justify-center" style="border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-xl);">
            <nav class="filter-nav">
                <button onclick="setFilter('category', 'all')" class="filter-tab active" id="tab-all">All</button>
                <button onclick="setFilter('category', 'expansion')" class="filter-tab" id="tab-expansion">Global Expansion</button>
                <button onclick="setFilter('category', 'sales')" class="filter-tab" id="tab-sales">Global Sales</button>
                <button onclick="setFilter('category', 'partner')" class="filter-tab" id="tab-partner">Distributor/Agent</button>
                <button onclick="setFilter('category', 'marketing')" class="filter-tab" id="tab-marketing">Marketing</button>
                <button onclick="setFilter('category', 'ec')" class="filter-tab" id="tab-ec">Cross-border EC</button>
                <button onclick="setFilter('category', 'countries')" class="filter-tab" id="tab-countries">Country & Region</button>
            </nav>
        </div>

        <!-- Tag filter status (shown only when tag filter is active) -->
        <div id="filter-status" class="mb-lg hidden" style="display: none;">
            <span class="text-lg font-bold">
                <span class="text-primary">#<span id="current-tag-name"></span></span> articles
            </span>
            <button onclick="resetFilter()" class="ml-sm text-sm text-secondary underline hover:text-primary" style="background:none; border:none; cursor:pointer;">
                Show all
            </button>
        </div>

        <!-- Article Grid -->
        <div class="grid-3" id="articles-grid">
            {% set all_posts = collections.blog | reverse %}
            {% set has_posts = false %}

            {% for post in all_posts %}
                {% if post.data.locale == locale %}
                    {% set has_posts = true %}

                    {% set topic_label = topic_translation[post.data.topic][locale] %}
                    {% if not topic_label %}
                        {% set topic_label = post.data.topic %}
                    {% endif %}

                    <article class="card p-0 blog-item article-card"
                             data-topic="{{ post.data.topic }}"
                             data-tags="{{ post.data.tags | join(',') }}"
                             data-date="{{ post.date.getTime() }}"
                             style="padding: 0; overflow: hidden; display: none; flex-direction: column; border: 1px solid var(--color-border); box-shadow: none; background: white; border-radius: 8px; transition: transform 0.2s;">

                        <a href="{{ post.url }}" style="display: block; aspect-ratio: 16/9; overflow: hidden;">
                            <img src="{{ post.data.thumbnail | default('https://placehold.co/600x400/f1f5f9/94a3b8?text=No+Image') }}"
                                 alt="{{ post.data.title }}"
                                 style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s;">
                        </a>

                        <div class="px-lg py-lg flex-col" style="flex: 1; display: flex;">
                            <div class="flex justify-between items-center mb-sm">
                                <span class="text-primary font-bold" style="font-size: 12px; background: rgba(193, 0, 51, 0.1); padding: 4px 8px; border-radius: 4px;">
                                    {{ topic_label }}
                                </span>
                                <time style="font-size: 12px; color: var(--color-text-secondary);">
                                    {{ post.date | date("yyyy.MM.dd") }}
                                </time>
                            </div>

                            <h3 style="font-size: 1.1rem; margin-bottom: var(--space-sm); line-height: 1.4; font-weight: bold;">
                                <a href="{{ post.url }}" style="color: inherit; text-decoration: none;">
                                    {{ post.data.title }}
                                </a>
                            </h3>

                            <p class="text-secondary mb-lg" style="flex: 1; font-size: 0.9rem; line-height: 1.6; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;">
                                {{ post.data.description }}
                            </p>

                            <div class="flex items-center pt-sm" style="border-top: 1px solid #eee;">
                                <div style="width: 24px; height: 24px; border-radius: 50%; background: #ccc; margin-right: 8px; overflow: hidden;">
                                    <img src="{{ post.data.author_image | default('https://placehold.co/100x100/ddd/fff?text=User') }}" alt="author" style="width:100%; height:100%; object-fit:cover;">
                                </div>
                                <span style="font-size: 12px; font-weight: bold; color: var(--color-text-primary);">
                                    {{ post.data.author | default('Leap Editorial Team') }}
                                </span>
                            </div>
                        </div>
                    </article>
                {% endif %}
            {% endfor %}

            <div id="no-results-message" class="text-center w-full flex items-center justify-center" style="grid-column: 1/-1; padding: var(--space-3xl) 0; display: none;">
                <p class="text-secondary">No articles found.</p>
            </div>
        </div>

        <!-- Pagination -->
        <div id="pagination-container" class="flex justify-center mt-xl" style="gap: 8px;">
            <!-- Generated by JS -->
        </div>

        {% if not has_posts %}
            <div class="text-center w-full flex items-center justify-center" style="padding: var(--space-2xl) 0;">
                <p class="text-secondary">No articles available at the moment.</p>
            </div>
        {% endif %}

    </div>
</section>

{% include "cta1.njk" %}

<style>
    .back-to-top {
        color: var(--color-text-secondary);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.2s, transform 0.2s;
        display: flex;
        align-items: center;
    }

    .back-to-top:hover {
        color: var(--color-primary-start);
        transform: translateX(-3px);
        text-decoration: underline;
    }

    .filter-nav {
        display: flex;
        gap: var(--space-lg);
        overflow-x: auto;
        padding-bottom: 0;
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .filter-nav::-webkit-scrollbar { display: none; }

    .filter-tab {
        background: none;
        border: none;
        padding-bottom: var(--space-sm);
        border-bottom: 3px solid transparent;
        color: var(--color-text-secondary);
        font-size: 1rem;
        white-space: nowrap;
        cursor: pointer;
        transition: all 0.3s;
        font-family: inherit;
    }
    .filter-tab:hover { color: var(--color-primary-start); }
    .filter-tab.active {
        border-bottom: 3px solid var(--color-primary-start);
        color: var(--color-primary-start);
        font-weight: bold;
    }

    .sort-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        font-family: inherit;
        font-size: inherit;
        color: var(--color-text-secondary);
        font-weight: normal;
        transition: color 0.3s;
    }
    .sort-btn:hover { color: var(--color-primary-start); }
    .sort-btn.active {
        color: var(--color-primary-start);
        font-weight: bold;
        text-decoration: underline;
    }

    .page-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid var(--color-border);
        background: white;
        color: var(--color-text-primary);
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .page-btn:hover {
        border-color: var(--color-primary-start);
        color: var(--color-primary-start);
    }
    .page-btn.active {
        background: var(--color-primary-start);
        color: white;
        border-color: var(--color-primary-start);
    }
    .page-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .blog-item:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
    }
    .blog-item:hover h3 a { color: var(--color-primary-start) !important; }
</style>

<script>
    const ITEMS_PER_PAGE = 15;
    let currentState = {
        filterType: 'category',
        filterValue: 'all',
        sortType: 'date',
        currentPage: 1
    };

    let allArticleElements = [];

    document.addEventListener("DOMContentLoaded", function() {
        allArticleElements = Array.from(document.querySelectorAll('.article-card'));

        const urlParams = new URLSearchParams(window.location.search);
        const tag = urlParams.get('tag');

        if (tag) {
            setFilter('tag', tag);
        } else {
            render();
        }
    });

    function setFilter(type, value) {
        currentState.filterType = type;
        currentState.filterValue = value;
        currentState.currentPage = 1;
        render();
    }

    function setSortType(type) {
        currentState.sortType = type;
        render();
    }

    function goToPage(page) {
        currentState.currentPage = page;
        render();
        const grid = document.getElementById('articles-grid');
        grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function resetFilter() {
        const url = new URL(window.location);
        url.searchParams.delete('tag');
        window.history.pushState({}, '', url);
        setFilter('category', 'all');
    }

    function render() {
        updateUIControls();

        let filteredArticles = allArticleElements.filter(article => {
            if (currentState.filterType === 'category') {
                const topic = article.getAttribute('data-topic');
                return currentState.filterValue === 'all' || topic === currentState.filterValue;
            } else if (currentState.filterType === 'tag') {
                const tags = article.getAttribute('data-tags') || "";
                return tags.split(',').includes(currentState.filterValue);
            }
            return true;
        });

        filteredArticles.sort((a, b) => {
            const dateA = Number(a.getAttribute('data-date') || 0);
            const dateB = Number(b.getAttribute('data-date') || 0);
            return currentState.sortType === 'views' ? dateA - dateB : dateB - dateA;
        });

        const totalItems = filteredArticles.length;
        const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);

        if (currentState.currentPage > totalPages && totalPages > 0) {
            currentState.currentPage = totalPages;
        }

        const startIndex = (currentState.currentPage - 1) * ITEMS_PER_PAGE;
        const visibleArticles = filteredArticles.slice(startIndex, startIndex + ITEMS_PER_PAGE);

        const grid = document.getElementById('articles-grid');
        allArticleElements.forEach(el => el.style.display = 'none');
        visibleArticles.forEach(el => {
            el.style.display = 'flex';
            grid.appendChild(el);
        });

        const noResultsMsg = document.getElementById('no-results-message');
        noResultsMsg.style.display = totalItems === 0 ? 'flex' : 'none';

        renderPaginationControls(totalPages);
    }

    function updateUIControls() {
        document.querySelectorAll('.sort-btn').forEach(btn => btn.classList.remove('active'));
        document.getElementById('sort-' + currentState.sortType).classList.add('active');

        const statusDiv = document.getElementById('filter-status');
        const tagNameSpan = document.getElementById('current-tag-name');
        const tabs = document.querySelectorAll('.filter-tab');

        if (currentState.filterType === 'tag') {
            tabs.forEach(tab => tab.classList.remove('active'));
            statusDiv.style.display = 'block';
            tagNameSpan.textContent = currentState.filterValue;
        } else {
            statusDiv.style.display = 'none';
            tabs.forEach(tab => tab.classList.remove('active'));
            const activeTab = document.getElementById('tab-' + currentState.filterValue);
            if (activeTab) activeTab.classList.add('active');
        }
    }

    function renderPaginationControls(totalPages) {
        const container = document.getElementById('pagination-container');
        container.innerHTML = '';

        if (totalPages <= 1) return;

        const prevBtn = document.createElement('button');
        prevBtn.className = 'page-btn';
        prevBtn.innerHTML = '&lsaquo;';
        prevBtn.disabled = currentState.currentPage === 1;
        prevBtn.onclick = () => goToPage(currentState.currentPage - 1);
        container.appendChild(prevBtn);

        let startPage = Math.max(1, currentState.currentPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);

        if (startPage > 1) {
            container.appendChild(createPageBtn(1));
            if (startPage > 2) {
                const dots = document.createElement('span');
                dots.textContent = '...';
                dots.style.alignSelf = 'center';
                container.appendChild(dots);
            }
        }

        for (let i = startPage; i <= endPage; i++) {
            container.appendChild(createPageBtn(i));
        }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1) {
                const dots = document.createElement('span');
                dots.textContent = '...';
                dots.style.alignSelf = 'center';
                container.appendChild(dots);
            }
            container.appendChild(createPageBtn(totalPages));
        }

        const nextBtn = document.createElement('button');
        nextBtn.className = 'page-btn';
        nextBtn.innerHTML = '&rsaquo;';
        nextBtn.disabled = currentState.currentPage === totalPages;
        nextBtn.onclick = () => goToPage(currentState.currentPage + 1);
        container.appendChild(nextBtn);
    }

    function createPageBtn(pageNum) {
        const btn = document.createElement('button');
        btn.className = 'page-btn';
        if (pageNum === currentState.currentPage) btn.classList.add('active');
        btn.textContent = pageNum;
        btn.onclick = () => goToPage(pageNum);
        return btn;
    }
</script>
