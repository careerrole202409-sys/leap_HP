<script>
(function () {
  var section = document.getElementById('showcaseSection');
  var track = document.getElementById('showcaseTrack');
  var items = track.querySelectorAll('.lp-showcase-item');
  var COUNT = 4;
  var GAP = 20;
  var current = 1;
  var animating = false;

  function cardW() { return items[0].offsetWidth; }
  function centerOffset() { return (section.offsetWidth - cardW()) / 2; }
  function posFor(idx) { return centerOffset() - idx * (cardW() + GAP); }

  function applyClasses() {
    items.forEach(function(item, i) {
      item.classList.toggle('is-active', i === current);
      item.classList.toggle('is-prev', i === current - 1);
      item.classList.toggle('is-next', i === current + 1);
    });
  }

  function goTo(idx, animate) {
    current = idx;
    track.style.transition = animate ? 'transform 0.7s cubic-bezier(0.4,0,0.2,1)' : 'none';
    track.style.transform = 'translateX(' + posFor(current) + 'px)';
    applyClasses();
  }

  function jumpTo(idx) {
    track.style.transition = 'none';
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        current = idx;
        track.style.transform = 'translateX(' + posFor(idx) + 'px)';
        applyClasses();
        animating = false;
      });
    });
  }

  track.addEventListener('transitionend', function (e) {
    if (e.target !== track) return;
    if (e.propertyName !== 'transform') return;
    if (current === items.length - 1) jumpTo(1);
    else if (current === 0) jumpTo(COUNT);
    else animating = false;
  });

  window.addEventListener('resize', function () { goTo(current, false); });
  goTo(1, false);

  setInterval(function () {
    if (animating) return;
    animating = true;
    goTo(current + 1, true);
  }, 2000);
})();
</script>

