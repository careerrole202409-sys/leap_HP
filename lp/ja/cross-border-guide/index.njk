<script>
// 資料ダウンロード：送信先はHP右下のCTAと同じGoogleフォーム（_data/guideForm.json）
(function () {
  var GUIDE_FORM = {{ guideForm | dump | safe }};
  var card = document.getElementById('download');
  var leadMeasured = false;   // OpenAI広告のコンバージョンは、送信1回につき1度だけ送る

  document.getElementById('cb-form').addEventListener('submit', function (e) {
    e.preventDefault();
    var form = e.target;
    if (!form.reportValidity()) return;

    // 送信ボタンを押した流れの中で開くので、ポップアップブロックされない
    window.open(GUIDE_FORM.pdfCrossBorder, '_blank', 'noopener');

    var data = new FormData();
    ['email', 'phone'].forEach(function (key) {
      data.append(GUIDE_FORM.entries[key], form.elements[key].value.trim());
    });
    data.append(GUIDE_FORM.entries.source, location.origin + location.pathname);   // 流入元：このLPのURL
    fetch(GUIDE_FORM.action, { method: 'POST', mode: 'no-cors', body: data, keepalive: true }).catch(function () {});

    try { localStorage.setItem('leapGuideRequested', '1'); } catch (err) {}
    if (typeof gtag === 'function') gtag('event', 'generate_lead', { lead_source: 'lp_guide' });
    // OpenAI広告のコンバージョン（標準イベント lead_created）。送信が完了したこのタイミングでだけ呼ぶ
    if (!leadMeasured && typeof oaiq === 'function') {
      oaiq('measure', 'lead_created', { type: 'customer_action' });
      leadMeasured = true;
    }
    card.classList.add('is-done');
  });

  // スクロールで画面に入った要素を表示する
  if (document.documentElement.classList.contains('js-motion') && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (items) {
      items.forEach(function (item) {
        if (!item.isIntersecting) return;
        item.target.classList.add('is-in');
        io.unobserve(item.target);
      });
    }, { threshold: 0.2 });
    document.querySelectorAll('.rv').forEach(function (el) { io.observe(el); });
  } else {
    document.querySelectorAll('.rv').forEach(function (el) { el.classList.add('is-in'); });
  }

  var motion = document.documentElement.classList.contains('js-motion');
  // ヒーローのデモ：重ねた資料を1枚ずつめくり、見どころを赤い枠で示す
  var demo = document.getElementById('gd-demo');
  if (demo) {
    var sheets = demo.querySelectorAll('.gd-sheet');
    var current = 0;
    var markLater = function (el) { setTimeout(function () { el.classList.add('is-mark'); }, 450); };
    var flip = function () {
      var cur = sheets[current];
      var nextIndex = (current + 1) % sheets.length;
      var next = sheets[nextIndex];
      var after = sheets[(nextIndex + 1) % sheets.length];
      cur.classList.remove('is-mark');
      cur.classList.add('is-flip');
      setTimeout(function () {
        cur.classList.remove('is-on', 'is-flip');
        next.classList.remove('is-next');
        next.classList.add('is-on');
        after.classList.add('is-next');
        markLater(next);
        current = nextIndex;
      }, 750);
    };
    markLater(sheets[0]);
    if (motion) setInterval(flip, 3400);
  }

  // ロゴを押したら、このLPの一番上に戻る
  document.querySelectorAll('.js-top').forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      // URLの「#〜」も消す（戻るの履歴は増やさない）
      history.replaceState(null, '', location.pathname + location.search);
    });
  });

  // スマホのメニュー
  var hamburger = document.getElementById('hamburger');
  var mobileMenu = document.getElementById('mobileMenu');
  var closeMenu = function () {
    hamburger.classList.remove('active');
    mobileMenu.classList.remove('active');
    document.body.style.overflow = '';
  };
  hamburger.addEventListener('click', function () {
    hamburger.classList.toggle('active');
    mobileMenu.classList.toggle('active');
    document.body.style.overflow = mobileMenu.classList.contains('active') ? 'hidden' : '';
  });
  mobileMenu.addEventListener('click', function (e) { if (e.target === mobileMenu) closeMenu(); });
  mobileMenu.querySelectorAll('.mobile-nav-link').forEach(function (link) { link.addEventListener('click', closeMenu); });

  // 「無料で始める」のクリックを、資料請求とは別のイベントで計測する
  document.querySelectorAll('.js-signup').forEach(function (a) {
    a.addEventListener('click', function () {
      if (typeof gtag === 'function') gtag('event', 'sign_up_click', { lead_source: 'lp_guide' });
    });
  });
})();
</script>
