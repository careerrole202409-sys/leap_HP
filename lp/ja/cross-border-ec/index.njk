<style>
/* ===== 共通 ===== */
.cb-nav-right { display: flex !important; }
.lp-section { padding: 4.5rem 1rem; background: white; }
.lp-section.is-soft { background: #f8f9fc; }
.lp-inner { max-width: 1040px; margin: 0 auto; }
.lp-section-title {
  text-align: center;
  font-size: clamp(1.5rem, 3vw, 2.1rem);
  font-weight: 800;
  color: #1a1a2e;
  margin-bottom: 2.5rem;
  line-height: 1.4;
}
.cb-btn {
  display: inline-block; padding: 1rem 2.75rem; border: none; border-radius: 50px;
  background: linear-gradient(135deg, #C10033 0%, #8B0024 100%);
  color: white; font-size: 1.05rem; font-weight: 700; font-family: inherit; text-decoration: none; cursor: pointer;
  box-shadow: 0 6px 18px rgba(193,0,51,0.3);
}
.cb-btn:hover { color: white; text-decoration: none; }

/* 数秒おきに光が横切るエフェクト */
.cta-shine { position: relative; overflow: hidden; }
.cta-shine::after {
  content: ""; position: absolute; top: 0; left: -60%; width: 40%; height: 100%;
  background: linear-gradient(100deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.45) 50%, rgba(255,255,255,0) 100%);
  transform: skewX(-20deg); animation: cta-shine 5s ease-in-out infinite; pointer-events: none;
}
@keyframes cta-shine { 0% { left: -60%; } 20% { left: 130%; } 100% { left: 130%; } }
@media (prefers-reduced-motion: reduce) { .cta-shine::after { display: none; } }

/* ===== ヒーロー ===== */
.cb-hero { background: linear-gradient(180deg, #fdf1f4 0%, #fff7f9 100%); padding: 3rem 1rem 3.5rem; }
.cb-hero-inner { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 3rem; align-items: center; }
.cb-hero-label { color: #C10033; font-weight: 700; letter-spacing: 0.08em; font-size: 0.9rem; margin-bottom: 0.8rem; }
.cb-hero h1 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; color: #1a1a2e; line-height: 1.3; letter-spacing: -0.01em; margin-bottom: 1rem; }
.cb-hero h1 span { display: inline-block; }
.cb-hero-lead { color: #475569; font-size: 1.05rem; line-height: 1.8; margin: 0; }

/* チャットで3分で作る様子のデモ */
.cb-demo { position: relative; margin-top: 1.75rem; max-width: 620px; background: white; border: 1px solid #ecd9de; border-radius: 16px; box-shadow: 0 24px 60px rgba(193,0,51,0.14), 0 6px 18px rgba(15,23,42,0.08); overflow: hidden; }
.cb-demo-bar { display: flex; align-items: center; gap: 6px; padding: 9px 12px; border-bottom: 1px solid #eef0f3; background: #fafbfc; }
.cb-demo-bar > i { width: 9px; height: 9px; border-radius: 50%; background: #e2e8f0; flex-shrink: 0; }
.cb-demo-url { flex: 1; min-width: 0; margin-left: 8px; display: flex; align-items: center; gap: 6px; background: white; border: 1px solid #e5e7eb; border-radius: 20px; padding: 3px 10px; font-size: 0.72rem; color: #64748b; white-space: nowrap; overflow: hidden; }
.cb-demo-url svg { width: 11px; height: 11px; flex-shrink: 0; }
.cb-demo-live { font-size: 0.66rem; font-weight: 800; color: white; background: #16a34a; border-radius: 20px; padding: 1px 8px; opacity: 0; transform: scale(0.6); transition: opacity 0.3s, transform 0.3s; }
.cb-demo.is-live .cb-demo-live { opacity: 1; transform: none; }

/* 今の段階 */
.cb-demo-caption { display: flex; align-items: center; gap: 0.75rem; padding: 10px 14px; border-bottom: 1px solid #f3e3e7; background: linear-gradient(90deg, #fff5f7, #ffffff); }
.cb-demo-caption-text { flex: 1; min-width: 0; font-size: 0.9rem; font-weight: 800; color: #1a1a2e; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: opacity 0.25s; }
.cb-demo-caption-text b { color: #C10033; margin-right: 0.5rem; letter-spacing: 0.05em; }
.cb-demo-caption-text.is-fade { opacity: 0; }
.cb-demo-bars { display: flex; gap: 4px; flex-shrink: 0; }
.cb-demo-bars i { width: 22px; height: 4px; border-radius: 2px; background: #f1d5dc; transition: background 0.3s; }
.cb-demo-bars i.is-done { background: #C10033; }

.cb-demo-body { display: grid; grid-template-columns: 0.82fr 1.18fr; height: 290px; }

/* チャット */
.cb-demo-chat { display: flex; flex-direction: column; border-right: 1px solid #eef0f3; min-width: 0; min-height: 0; overflow: hidden; }
/* 新しい吹き出しが下に出て、古いものは上に押し出される */
.cb-demo-msgs { flex: 1; min-height: 0; padding: 12px 10px; display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; overflow: hidden; }
.cb-msg { display: none; flex-shrink: 0; }
.cb-msg.is-show { display: block; }
.cb-msg { max-width: 92%; font-size: 0.78rem; line-height: 1.5; padding: 7px 10px; border-radius: 12px; opacity: 0; transform: translateY(8px); transition: opacity 0.35s, transform 0.35s; }
.cb-msg.is-on { opacity: 1; transform: none; }
.cb-typing { display: inline-flex; gap: 4px; padding: 3px 2px; }
.cb-typing i { width: 6px; height: 6px; border-radius: 50%; background: #94a3b8; animation: cb-dot 1s ease-in-out infinite; }
.cb-typing i:nth-child(2) { animation-delay: 0.15s; }
.cb-typing i:nth-child(3) { animation-delay: 0.3s; }
.cb-msg.is-ai { background: #f1f5f9; color: #1a1a2e; border-bottom-left-radius: 3px; }
.cb-msg.is-me { align-self: flex-end; background: #C10033; color: white; border-bottom-right-radius: 3px; }
.cb-demo-input { flex-shrink: 0; margin: 0 8px 8px; display: flex; align-items: center; gap: 6px; border: 1px solid #e5e7eb; border-radius: 10px; padding: 6px 8px; min-height: 32px; transition: border-color 0.2s, box-shadow 0.2s; }
.cb-demo-input.is-focus { border-color: #C10033; box-shadow: 0 0 0 3px rgba(193,0,51,0.10); }
.cb-demo-typed { flex: 1; font-size: 0.76rem; color: #1a1a2e; white-space: nowrap; overflow: hidden; }
.cb-demo-typed:empty::before { content: "メッセージを入力"; color: #cbd5e1; }
.cb-demo-typed.is-typing::after { content: ""; display: inline-block; width: 1px; height: 0.95em; margin-left: 1px; background: #C10033; vertical-align: -1px; animation: cb-caret 0.8s steps(1) infinite; }
@keyframes cb-caret { 50% { opacity: 0; } }
.cb-demo-send { width: 22px; height: 22px; border-radius: 6px; background: #C10033; color: white; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.cb-demo-send svg { width: 12px; height: 12px; }

/* 右側 */
.cb-demo-stage { position: relative; background: #f8fafc; overflow: hidden; }
.cb-demo-layer { position: absolute; inset: 0; padding: 12px; opacity: 0; transition: opacity 0.45s; }
.cb-demo-layer.is-on { opacity: 1; }
.cb-demo-idle { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; text-align: center; }
.cb-demo-idle p { margin: 0; font-size: 0.78rem; font-weight: 700; color: #94a3b8; line-height: 1.6; }
.cb-demo-dots { display: flex; gap: 6px; }
.cb-demo-dots i { width: 7px; height: 7px; border-radius: 50%; background: #e7b8c4; animation: cb-dot 1.2s ease-in-out infinite; }
.cb-demo-dots i:nth-child(2) { animation-delay: 0.15s; }
.cb-demo-dots i:nth-child(3) { animation-delay: 0.3s; }
@keyframes cb-dot { 0%, 100% { transform: translateY(0); opacity: 0.5; } 50% { transform: translateY(-5px); opacity: 1; } }

.cb-demo-tpls { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; height: 100%; align-items: center; }
.cb-demo-tpl { border: 2px solid transparent; border-radius: 9px; overflow: hidden; background: white; box-shadow: 0 4px 12px rgba(15,23,42,0.08); opacity: 0; transform: translateY(10px) scale(0.96); transition: opacity 0.35s, transform 0.35s, border-color 0.2s, box-shadow 0.2s; }
.cb-demo-tpl.is-on { opacity: 1; transform: none; }
.cb-demo-tpl.is-picked { border-color: #C10033; transform: scale(1.06); box-shadow: 0 10px 24px rgba(193,0,51,0.25); }
/* テンプレートのミニ見本（HTML） */
.cb-mini { aspect-ratio: 3 / 4.2; display: flex; flex-direction: column; gap: 5px; padding: 6px; background: white; font-family: Georgia, "Times New Roman", serif; }
.cb-mini b { font-size: 0.5rem; letter-spacing: 0.2em; color: #1a1a2e; }
.cb-mini-hero { display: block; flex: 1.2; border-radius: 2px; }
.cb-mini span { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
.cb-mini span img, .cb-mini span em { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 2px; }
.cb-mini.is-maison .cb-mini-hero { background: linear-gradient(90deg, rgba(20,16,12,0.6), rgba(20,16,12,0.1)), url("/assets/images/lp-demo/hero.jpg") center 40% / cover; }
.cb-mini.is-light { background: #faf7f2; }
.cb-mini.is-light .cb-mini-hero { background: linear-gradient(180deg, #efe7dc 0 55%, #e2d6c6 55%); }
.cb-mini.is-light span em { background: #ebe3d8; }
.cb-mini.is-green .cb-mini-hero { background: linear-gradient(135deg, #3f5b4c, #6f8f7a); }
.cb-mini.is-green span em { background: #dfe8e1; }
.cb-demo-cursor { position: absolute; left: 86%; top: 86%; width: 22px; height: 22px; z-index: 2; transition: left 0.65s cubic-bezier(.4,0,.2,1), top 0.65s cubic-bezier(.4,0,.2,1), transform 0.15s; filter: drop-shadow(0 2px 3px rgba(0,0,0,0.25)); }
.cb-demo-cursor.is-moved { left: 19%; top: 55%; }
.cb-demo-cursor.is-click { transform: scale(0.8); }

.cb-demo-progress { position: absolute; left: 12px; right: 12px; top: 12px; z-index: 2; display: flex; align-items: center; gap: 8px; font-size: 0.7rem; font-weight: 700; color: #64748b; background: rgba(255,255,255,0.92); border: 1px solid #e5e7eb; border-radius: 8px; padding: 6px 9px; transition: opacity 0.3s; }
.cb-demo-progress span { flex: 1; height: 5px; background: #e2e8f0; border-radius: 3px; overflow: hidden; }
.cb-demo-progress span i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #C10033, #ff5a7a); border-radius: 3px; }
.cb-demo-progress.is-run span i { width: 100%; transition: width 2.2s cubic-bezier(.3,.1,.3,1); }
.cb-demo-progress.is-hide { opacity: 0; }

/* 組み上がるECサイト（文字はすべてHTML） */
.cb-site { background: white; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; box-shadow: 0 6px 18px rgba(15,23,42,0.08); font-family: Georgia, "Times New Roman", serif; }
.cb-site > * { opacity: 0; transform: translateY(12px); transition: opacity 0.45s, transform 0.45s; }
.cb-site > .is-on { opacity: 1; transform: none; }
.cb-site-head { display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-bottom: 1px solid #f1f5f9; }
.cb-site-head b { font-size: 0.74rem; color: #1a1a2e; letter-spacing: 0.22em; font-weight: 700; }
.cb-site-head i { flex: 1; }
.cb-site-head em { font-style: normal; font-size: 0.58rem; color: #64748b; letter-spacing: 0.06em; }
.cb-site-lang { font-family: -apple-system, sans-serif; font-style: normal; font-size: 0.6rem; font-weight: 800; color: #C10033; border: 1px solid #f3c4cf; border-radius: 10px; padding: 0 6px; }
.cb-site-hero { position: relative; height: 96px; background: #d9d4cc url("/assets/images/lp-demo/hero.jpg") center 40% / cover no-repeat; display: flex; flex-direction: column; justify-content: center; padding: 0 14px; }
.cb-site-hero::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20,16,12,0.62) 0%, rgba(20,16,12,0.15) 75%); }
.cb-site-hero strong { position: relative; color: white; font-size: 0.95rem; font-weight: 400; line-height: 1.25; max-width: 62%; }
.cb-site-hero span { position: relative; align-self: flex-start; margin-top: 6px; font-size: 0.56rem; letter-spacing: 0.12em; color: #1a1a2e; background: white; padding: 3px 9px; text-transform: uppercase; }
.cb-site-title { font-size: 0.72rem; color: #1a1a2e; letter-spacing: 0.08em; padding: 8px 10px 5px; }
.cb-site-items { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 0 10px 10px; }
.cb-site-item img { width: 100%; height: 44px; object-fit: cover; display: block; background: #f1f5f9; }
.cb-site-item span { display: flex; justify-content: space-between; font-size: 0.62rem; color: #64748b; margin-top: 4px; }
.cb-site-item b { color: #1a1a2e; font-weight: 700; }
.cb-swap { transition: opacity 0.25s; }
.cb-swap.is-fade { opacity: 0; }

@media (prefers-reduced-motion: no-preference) {
  .cb-demo { animation: cb-float 7s ease-in-out infinite; }
}
@keyframes cb-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }

/* フォーム上の資料 */
.cb-form-head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.1rem; }
.cb-form-deck { position: relative; flex-shrink: 0; width: 116px; height: 78px; }
.cb-form-deck img { position: absolute; width: 100px; border-radius: 5px; border: 1px solid #e5e7eb; box-shadow: 0 6px 14px rgba(15,23,42,0.15); }
.cb-form-deck img:first-child { right: 0; top: 0; transform: rotate(6deg); }
.cb-form-deck img:last-child { left: 0; bottom: 0; }
.cb-form-head .cb-form-title, .cb-form-head .cb-form-sub { text-align: left; }
.cb-form-head .cb-form-sub { margin: 0; }

/* フォーム */
.cb-form-card { background: white; border-radius: 18px; border: 1px solid #f1d5dc; box-shadow: 0 16px 40px rgba(193,0,51,0.10); padding: 1.75rem 1.5rem 1.5rem; scroll-margin-top: 110px; }
.cb-form-title { font-size: 1.2rem; font-weight: 800; color: #1a1a2e; margin: 0 0 0.25rem; text-align: center; }
.cb-form-sub { font-size: 0.85rem; color: #475569; text-align: center; margin: 0 0 1.1rem; }
.cb-field { margin-bottom: 0.75rem; }
.cb-field label { display: flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: 700; color: #334155; margin-bottom: 4px; }
.cb-tag { font-size: 0.68rem; font-weight: 700; padding: 1px 6px; border-radius: 4px; background: #C10033; color: white; }
.cb-tag.is-optional { background: #E2E8F0; color: #64748B; }
.cb-field input { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid #CBD5E1; border-radius: 8px; font-size: 16px; font-family: inherit; }
.cb-field input:focus { outline: none; border-color: #C10033; box-shadow: 0 0 0 3px rgba(193,0,51,0.12); }
.cb-agree { display: flex; align-items: flex-start; gap: 8px; font-size: 0.8rem; color: #475569; margin: 0.4rem 0 1rem; line-height: 1.5; }
.cb-agree input { margin-top: 3px; accent-color: #C10033; }
.cb-agree a { color: #C10033; text-decoration: underline; }
.cb-form-card .cb-btn { display: block; width: 100%; padding: 14px; font-size: 1rem; }
.cb-done { display: none; text-align: center; padding: 1.5rem 0.5rem; }
.cb-done p { color: #475569; font-size: 0.9rem; margin: 0 0 0.9rem; }
.cb-done a { color: #C10033; font-size: 0.85rem; text-decoration: underline; }
.cb-form-card.is-done form { display: none; }
.cb-form-card.is-done .cb-done { display: block; }

@media (max-width: 900px) {
  .cb-hero { padding: 2rem 1rem 2.5rem; }
  .cb-hero-inner { grid-template-columns: 1fr; gap: 1.5rem; }
  .cb-demo { max-width: none; }
  .cb-demo-body { height: 270px; }
}

/* ===== 特徴（課題への答え） ===== */
.cb-answer { display: grid; grid-template-columns: 1fr 1.05fr; gap: 3rem; align-items: center; padding: 2.75rem 0; border-top: 1px solid #e5e7eb; }
.cb-answer:first-of-type { border-top: 0; padding-top: 0; }
.cb-answer.is-reverse .cb-answer-text { order: 2; }
.cb-answer-q { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; font-weight: 700; color: #64748b; background: #f1f5f9; border-radius: 20px; padding: 4px 12px; margin-bottom: 0.9rem; }
.cb-answer-q b { color: #C10033; }
.cb-answer h3 { font-size: clamp(1.3rem, 2.4vw, 1.7rem); font-weight: 800; color: #1a1a2e; line-height: 1.45; margin-bottom: 0.75rem; }
.cb-answer p { color: #475569; line-height: 1.8; margin-bottom: 1rem; }
.cb-answer .cb-check { margin-top: 0.25rem; }
.cb-answer-img { width: 100%; border-radius: 14px; border: 1px solid #e5e7eb; box-shadow: 0 8px 26px rgba(15,23,42,0.08); background: white; display: block; }
.cb-answer-tpls { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
.cb-answer-tpls img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-radius: 10px; border: 1px solid #e5e7eb; box-shadow: 0 6px 18px rgba(15,23,42,0.08); display: block; }
.cb-nums { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
.cb-num { background: #fff5f7; border: 1px solid #f3c4cf; border-radius: 12px; padding: 0.8rem 0.5rem; text-align: center; }
.cb-num-value { font-size: clamp(1.5rem, 2.8vw, 1.9rem); font-weight: 900; color: #C10033; line-height: 1.15; }
.cb-num-value small { font-size: 0.55em; margin-left: 0.1em; }
.cb-num-label { font-size: 0.75rem; font-weight: 700; color: #64748b; margin-top: 0.2rem; }
