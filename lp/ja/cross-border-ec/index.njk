        <img src="https://res.cloudinary.com/duh6rnjba/image/upload/v1767489330/CareerRole%E6%A7%98_%E6%A8%AAwhite_RGB_4_vfmrzc.png" alt="Leap" class="footer-logo-img">
      </a>
      <div class="footer-copyright">Copyright © 2025 Leap, Inc.</div>
    </div>
  </div>
</footer>

<script>
// 資料ダウンロード：送信先はHP右下のCTAと同じGoogleフォーム（_data/guideForm.json）
(function () {
  var GUIDE_FORM = {{ guideForm | dump | safe }};
  var card = document.getElementById('cb-form-card');

  document.getElementById('cb-form').addEventListener('submit', function (e) {
    e.preventDefault();
    var form = e.target;
    if (!form.reportValidity()) return;

    // 送信ボタンを押した流れの中で開くので、ポップアップブロックされない
    window.open(GUIDE_FORM.pdf, '_blank', 'noopener');

    var data = new FormData();
    ['company', 'name', 'email', 'phone'].forEach(function (key) {
      data.append(GUIDE_FORM.entries[key], form.elements[key].value.trim());
    });
    data.append(GUIDE_FORM.entries.source, location.origin + location.pathname);   // 流入元：このLPのURL
    fetch(GUIDE_FORM.action, { method: 'POST', mode: 'no-cors', body: data, keepalive: true }).catch(function () {});

    try { localStorage.setItem('leapGuideRequested', '1'); } catch (err) {}
    if (typeof gtag === 'function') gtag('event', 'generate_lead', { lead_source: 'lp_google' });
    card.classList.add('is-done');
  });

  // スクロールで画面に入った要素を表示し、数字をカウントアップする
  var countUp = function (el) {
    var end = Number(el.getAttribute('data-count'));
    var start = null;
    var step = function (ts) {
      if (start === null) start = ts;
      var t = Math.min((ts - start) / 1000, 1);
      el.textContent = Math.round(end * (1 - Math.pow(1 - t, 3)));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if (document.documentElement.classList.contains('js-motion') && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (items) {
      items.forEach(function (item) {
        if (!item.isIntersecting) return;
        item.target.classList.add('is-in');
        item.target.querySelectorAll('.js-count').forEach(countUp);
        io.unobserve(item.target);
      });
    }, { threshold: 0.2 });
    document.querySelectorAll('.rv').forEach(function (el) { io.observe(el); });
  } else {
    document.querySelectorAll('.rv').forEach(function (el) { el.classList.add('is-in'); });
  }

  // ヒーローのデモ：チャットに答えて、デザインを選び、サイトが公開されるまでを見せる
  var motion = document.documentElement.classList.contains('js-motion');
  var demo = document.getElementById('cb-demo');
  if (demo) {
    var q = function (sel) { return demo.querySelector(sel); };
    var qa = function (sel) { return demo.querySelectorAll(sel); };
    var typed = q('.cb-demo-typed');
    var caption = q('.cb-demo-caption-text');
    var captions = ['', 'チャットの質問に答える', 'デザインを選ぶ', 'サイトが完成して、公開'];
    var timers = [];
    var at = function (ms, fn) { timers.push(setTimeout(fn, ms)); };
    var layer = function (name) { qa('.cb-demo-layer').forEach(function (el) { el.classList.toggle('is-on', el.classList.contains('cb-demo-' + name)); }); };

    var setStep = function (n, animate) {
      var apply = function () { caption.innerHTML = '<b>STEP ' + n + '</b>' + captions[n]; caption.classList.remove('is-fade'); };
      qa('.cb-demo-bars i').forEach(function (b, i) { b.classList.toggle('is-done', i < n); });
      if (!animate) { apply(); return; }
      caption.classList.add('is-fade');
      setTimeout(apply, 250);
    };
    // AIの返事：点が跳ねる「考えている表示」のあと、1文字ずつ流れるように出す
    var aiText = {};
    qa('.cb-msg.is-ai').forEach(function (el) { aiText[el.getAttribute('data-msg')] = el.textContent; });
    var showAi = function (start, n) {
      var el = q('[data-msg="' + n + '"]');
      var text = aiText[n];
      at(start, function () { el.innerHTML = '<span class="cb-typing"><i></i><i></i><i></i></span>'; showMsg(n); });
      for (var i = 1; i <= text.length; i++) {
        (function (i) { at(start + 600 + i * 30, function () { el.textContent = text.slice(0, i); }); })(i);
      }
    };
    var showMsg = function (n) {
      var el = q('[data-msg="' + n + '"]');
      el.classList.add('is-show');
      requestAnimationFrame(function () { requestAnimationFrame(function () { el.classList.add('is-on'); }); });
    };
    var setLang = function (lang, animate) {
      qa('[data-' + lang + ']').forEach(function (el) {
        if (!animate) { el.textContent = el.getAttribute('data-' + lang); return; }
        el.classList.add('is-fade');
        setTimeout(function () { el.textContent = el.getAttribute('data-' + lang); el.classList.remove('is-fade'); }, 250);
      });
    };
    var type = function (start, text, msgNo) {
      var input = q('.cb-demo-input');
      at(start, function () { input.classList.add('is-focus'); typed.classList.add('is-typing'); });
      for (var i = 1; i <= text.length; i++) {
        (function (i) { at(start + i * 50, function () { typed.textContent = text.slice(0, i); }); })(i);
      }
      at(start + text.length * 50 + 250, function () { typed.textContent = ''; typed.classList.remove('is-typing'); input.classList.remove('is-focus'); showMsg(msgNo); });
    };
    var showFinal = function () {
      qa('.cb-msg').forEach(function (m) { m.classList.add('is-show', 'is-on'); });
      Object.keys(aiText).forEach(function (n) { q('[data-msg="' + n + '"]').textContent = aiText[n]; });
      layer('build');
      q('.cb-demo-progress').classList.add('is-hide');
      qa('.cb-site > *').forEach(function (el) { el.classList.add('is-on'); });
      setLang('fr', false);
      setStep(3, false);
      q('.cb-demo-urltext').textContent = 'your-store.leap.site';
      demo.classList.add('is-live');
    };
    var reset = function () {
      timers.forEach(clearTimeout); timers = [];
      demo.classList.remove('is-live');
      qa('.is-on, .is-show, .is-picked, .is-moved, .is-click, .is-run, .is-hide').forEach(function (el) { el.classList.remove('is-on', 'is-show', 'is-picked', 'is-moved', 'is-click', 'is-run', 'is-hide'); });
      setLang('en', false);
      q('.cb-demo-urltext').textContent = 'app.leap.site';
      typed.textContent = '';
    };
    var play = function () {
      reset();
      // STEP 1：チャットの質問に答える（約4.5秒）
      setStep(1, false);
      layer('idle');
      showAi(200, 1);
      type(1300, 'インテリア雑貨です', 2);
      showAi(2300, 3);
      type(3450, 'アメリカとフランスです', 4);
      // STEP 2：デザインを選ぶ（約2秒）
      at(4500, function () { setStep(2, true); layer('pick'); });
      qa('.cb-demo-tpl').forEach(function (el, i) { at(4650 + i * 120, function () { el.classList.add('is-on'); }); });
      at(5000, function () { q('.cb-demo-cursor').classList.add('is-moved'); });
      at(5800, function () { q('.cb-demo-cursor').classList.add('is-click'); q('.cb-demo-tpl').classList.add('is-picked'); });
      at(5950, function () { q('.cb-demo-cursor').classList.remove('is-click'); });
      // STEP 3：サイトが完成して、公開 → 英語からフランス語、ドルからユーロへ
      at(6600, function () { setStep(3, true); layer('build'); q('.cb-demo-progress').classList.add('is-run'); });
      qa('.cb-site > *').forEach(function (el, i) { at(6900 + i * 500, function () { el.classList.add('is-on'); }); });
      at(9200, function () { q('.cb-demo-progress').classList.add('is-hide'); });
      showAi(10000, 5);
      type(11400, '公開します', 6);
      at(12300, function () { q('.cb-demo-urltext').textContent = 'your-store.leap.site'; demo.classList.add('is-live'); });
      at(13300, function () { setLang('fr', true); });
      at(20000, play);
    };

    if (motion) { play(); } else { showFinal(); }
  }

  // 特徴02：価格の通貨を順番に切り替える
  var fx = document.getElementById('cb-fx-price');
  if (motion && fx) {
    var prices = [['¥12,000', 'JPY'], ['$80.00', 'USD'], ['€74.00', 'EUR']];
    var fxIndex = 0;
    setInterval(function () {
      fx.classList.add('is-fade');
      setTimeout(function () {
        fxIndex = (fxIndex + 1) % prices.length;
        fx.querySelector('strong').textContent = prices[fxIndex][0];
        fx.querySelector('.cb-fx-cur').textContent = prices[fxIndex][1];
        fx.classList.remove('is-fade');
      }, 300);
    }, 2000);
  }

  // ロゴを押したら、このLPの一番上に戻る
  document.querySelectorAll('.js-top').forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      // URLの「#〜」も消す（戻るの履歴は増やさない）
      history.replaceState(null, '', location.pathname + location.search);
    });
  });

  // スマホのメニュー
  var hamburger = document.getElementById('hamburger');
  var mobileMenu = document.getElementById('mobileMenu');
  var closeMenu = function () {
    hamburger.classList.remove('active');
    mobileMenu.classList.remove('active');
    document.body.style.overflow = '';
  };
  hamburger.addEventListener('click', function () {
    hamburger.classList.toggle('active');
    mobileMenu.classList.toggle('active');
    document.body.style.overflow = mobileMenu.classList.contains('active') ? 'hidden' : '';
  });
  mobileMenu.addEventListener('click', function (e) { if (e.target === mobileMenu) closeMenu(); });
  mobileMenu.querySelectorAll('.mobile-nav-link').forEach(function (link) { link.addEventListener('click', closeMenu); });

  // 「無料で始める」のクリックを、資料請求とは別のイベントで計測する
  document.querySelectorAll('.js-signup').forEach(function (a) {
    a.addEventListener('click', function () {
      if (typeof gtag === 'function') gtag('event', 'sign_up_click', { lead_source: 'lp_google' });
    });
  });
})();
</script>
</body>
</html>
